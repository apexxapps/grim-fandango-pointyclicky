+bool Sector::raycast(const Math::Vector3d &v0, const Math::Vector3d &v1, Math::Vector3d &hit) const {
+	if (_numVertices == 0 || _normal.getMagnitude() == 0)
+		return false;
+	double div = _normal.dotProduct(v1);
+	if (div == 0)
+		return false;
+	double s = _normal.dotProduct(_vertices[0] - v0) / div;
+	hit = v0 + (float)s * v1;
+	return true;
