+
+namespace Grim {
+
+// 0 pointer, 1 object, 2 exit, 3-6 the special modes' arrows, 7 busy (cutscene)
+static const int kNumCursors = 8;
+
+CursorData::CursorData(const Common::String &name) :
+	_anim(nullptr), _frameTick(0), _frame(0), _frames(0), _repeat(true) {
+	if (SearchMan.hasFile(Common::Path(name + "_0.tga"))) {
+		while (SearchMan.hasFile(Common::Path(Common::String::format("%s_%d.tga", name.c_str(), _frames))))
+			_frames++;
+		_anim = new Bitmap *[_frames];
+		for (int i = 0; i < _frames; i++)
+			_anim[i] = load(Common::String::format("%s_%d.tga", name.c_str(), i));
+	} else if (SearchMan.hasFile(Common::Path(name + ".tga"))) {
+		_frames = 1;
+		_anim = new Bitmap *[1];
+		_anim[0] = load(name + ".tga");
+	}
+}
+
+CursorData::~CursorData() {
+	delete[] _anim;
+}
+
+Bitmap *CursorData::load(const Common::String &name) {
+	Bitmap *bmp = Bitmap::create(name);
+	if (bmp) {
+		bmp->_data->load();
+		bmp->_data->_hasTransparency = true;
+	}
+	return bmp;
+}
+
+void CursorData::reset() {
+	_frame = 0;
+	_frameTick = g_system->getMillis();
+}
+
+void CursorData::draw(const Common::Point &pos) {
+	if (!_anim)
+		return;
+	const uint32 delta = 50;
+	uint32 curTick = g_system->getMillis();
+	if (curTick - _frameTick > 5 * delta) {
+		_frameTick = curTick;
+		_frame = 0;
+	}
+	while (curTick - _frameTick > delta) {
+		_frameTick += delta;
+		_frame++;
+		if (_repeat)
+			_frame = _frame % _frames;
+	}
+	if (_frame >= _frames || !_anim[_frame])
+		return;
+	Bitmap *bmp = _anim[_frame];
+	bmp->draw(pos.x - bmp->getWidth() / 2, pos.y - bmp->getHeight() / 2);
+}
+
+Cursor::Cursor() : _curCursor(0), _position(320, 210), _data(nullptr) {
+	for (int i = 0; i < 2; i++)
+		_persistentCursor[i] = -1;
+	loadAvailableCursors();
+}
+
+Cursor::~Cursor() {
+	if (_data) {
+		for (int i = 0; i < kNumCursors; i++)
+			delete _data[i];
+		delete[] _data;
+	}
+}
+
+void Cursor::loadAvailableCursors() {
+	if (!_data) {
+		_data = new CursorData *[kNumCursors];
+		for (int i = 0; i < kNumCursors; i++)
+			_data[i] = nullptr;
+	}
+	for (int i = 0; i < kNumCursors; i++) {
+		delete _data[i];
+		_data[i] = new CursorData(Common::String::format("cursor%d", i));
+	}
+	CursorMan.showMouse(false);
+}
+
+void Cursor::reload() {
+	loadAvailableCursors();
+}
+
+void Cursor::setCursor(int id) {
+	if (id >= kNumCursors)
+		id = 0;
+	if (_curCursor != id && id >= 0)
+		_data[id]->reset();
+	_curCursor = id;
+}
+
+void Cursor::setPersistent(int pc, int id, int x, int y) {
+	if (id >= kNumCursors)
+		id = -1;
+	if (_persistentCursor[pc] != id && id >= 0)
+		_data[id]->reset();
+	_persistentCursor[pc] = id;
+	_persistentPosition[pc].x = x;
+	_persistentPosition[pc].y = y;
+}
+
+void Cursor::draw() {
+	if (_curCursor >= 0)
+		_data[_curCursor]->draw(_position);
+	for (int i = 0; i < 2; i++)
+		if (_persistentCursor[i] >= 0)
+			_data[_persistentCursor[i]]->draw(_persistentPosition[i]);
+}
+
+} // end of namespace Grim
