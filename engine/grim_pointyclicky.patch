+
+namespace Grim {
+
+static HotspotMan *hotspots() {
+	return g_grim ? g_grim->getHotspotMan() : nullptr;
+}
+
+void Lua_V1::RegisterHotspot() {
+	HotspotMan *hm = hotspots();
+	if (!hm) {
+		lua_pushnumber(-1);
+		return;
+	}
+	Math::Vector3d pos(lua_getnumber(lua_getparam(2)),
+	                   lua_getnumber(lua_getparam(3)),
+	                   lua_getnumber(lua_getparam(4)));
+	const char *name = lua_getstring(lua_getparam(1));
+	const char *scene = lua_getstring(lua_getparam(5));
+	int n = hm->addHotspot(name ? name : "", pos, scene ? scene : "");
+	lua_pushnumber(n);
+}
+
+void Lua_V1::ActivateHotspot() {
+	HotspotMan *hm = hotspots();
+	if (!hm)
+		return;
+	int num = (int)lua_getnumber(lua_getparam(1));
+	if (num < 0) {
+		hm->disableAll();
+	} else if (HotObject *hs = hm->getObject(num)) {
+		hs->_active = getbool(2);
+	}
+}
+
+void Lua_V1::MouseUpdateHotspot() {
+	HotspotMan *hm = hotspots();
+	if (!hm)
+		return;
+	const char *id = lua_getstring(lua_getparam(1));
+	Math::Vector3d pos(lua_getnumber(lua_getparam(2)),
+	                   lua_getnumber(lua_getparam(3)),
+	                   lua_getnumber(lua_getparam(4)));
+	int visible = (int)lua_getnumber(lua_getparam(5));
+	hm->updateHotspot(id ? id : "", pos, visible);
+}
+
+void Lua_V1::SwitchControlMode() {
+	HotspotMan *hm = hotspots();
+	if (!hm)
+		return;
+	int mode = (int)lua_getnumber(lua_getparam(1));
+	hm->switchMode(mode);
+	if (mode == HotspotMan::Dialog || mode == HotspotMan::NoWalk) {
+		if (!lua_isnumber(lua_getparam(2)))
+			return;
+		int lines = (int)lua_getnumber(lua_getparam(2));
+		int x0 = (int)lua_getnumber(lua_getparam(3));
+		int y0 = (int)lua_getnumber(lua_getparam(4));
+		int width = (int)lua_getnumber(lua_getparam(5));
+		int height = (int)lua_getnumber(lua_getparam(6));
+		hm->setupDialog(x0, y0, width, height, lines, 1);
+	} else if (mode == HotspotMan::Linear) {
+		if (!lua_isnumber(lua_getparam(2)))
+			return;
+		Math::Vector3d axis(lua_getnumber(lua_getparam(2)),
+		                    lua_getnumber(lua_getparam(3)),
+		                    lua_getnumber(lua_getparam(4)));
+		hm->setAxis(axis, lua_getnumber(lua_getparam(5)));
+	} else if (mode == HotspotMan::Inventory) {
+		hm->setupDialog(20, 40, 100, 100, 4, 6);
+	}
+}
+
+void Lua_V1::NotifyWalk() {
+	HotspotMan *hm = hotspots();
+	if (hm)
+		hm->notifyWalk((int)lua_getnumber(lua_getparam(1)));
+}
+
+void Lua_V1::RegisterInventory() {
+	HotspotMan *hm = hotspots();
+	if (!hm)
+		return;
+	const char *id = lua_getstring(lua_getparam(1));
+	if (!id)
+		return;
+	if (!strcmp(id, "reset")) {
+		hm->resetInventory();
+	} else {
+		const char *pic = lua_getstring(lua_getparam(2));
+		hm->addInventory(id, pic ? pic : "");
+	}
+}
+
+void Lua_V1::MouseDown() {
+	lua_pushnumber(g_system->getEventManager()->getButtonState());
+}
+
+void Lua_V1::InteractMode() {
+}
+
+void Lua_V1::RenameHotspot() {
+	HotspotMan *hm = hotspots();
+	if (!hm)
+		return;
+	int id = (int)lua_getnumber(lua_getparam(1));
+	const char *name = lua_getstring(lua_getparam(2));
+	hm->renameHotspot(id, name ? name : "");
+}
+
+void Lua_V1::GetControlMode() {
+	HotspotMan *hm = hotspots();
+	lua_pushnumber(hm ? hm->getCtrlMode() : 0);
+}
+
+void Lua_V1::SetOptionMode() {
+	HotspotMan *hm = hotspots();
+	if (!hm) {
+		lua_pushstring("");
+		return;
+	}
+	const char *name = lua_getstring(lua_getparam(1));
+	Common::String old = hm->getOptionMode();
+	hm->setOptionMode(name ? name : "");
+	lua_pushstring(old.c_str());
+}
+
+} // end of namespace Grim
