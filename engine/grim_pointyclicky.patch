+class Bitmap;
+
+class CursorData {
+public:
+	CursorData(const Common::String &name);
+	~CursorData();
+	void draw(const Common::Point &pos);
+	void reset();
+
+private:
+	Bitmap *load(const Common::String &name);
+	Bitmap **_anim;
+	uint32 _frameTick;
+	int _frame, _frames;
+	bool _repeat;
+};
+
+class Cursor {
+public:
+	Cursor();
+	~Cursor();
+
+	Common::Point getPosition() const { return _position; }
