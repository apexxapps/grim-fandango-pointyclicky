+HotspotMan::HotspotMan() :
+	_cutScene(0), _ctrlMode(0), _rows(0), _cols(0), _x0(0), _y0(0), _w(0), _h(0),
+	_offset(0), _initialized(false), _flashHS(false), _flashStart(0), _activeHS(nullptr) {
+	for (int i = 0; i < 8; i++)
+		_flashBitmaps[i] = nullptr;
+	ConfMan.registerDefault("grim_mouse_debug", false);
+	ConfMan.registerDefault("grim_mouse_names", false);
+	_showDebug = ConfMan.getBool("grim_mouse_debug");
+	_showNames = ConfMan.getBool("grim_mouse_names");
+}
