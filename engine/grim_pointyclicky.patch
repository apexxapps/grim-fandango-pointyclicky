+static const int kGameW = 640, kGameH = 480;
+
+void HotPolygon::draw(const Color &col) {
+	for (uint i = 0; i < _pnts.size(); i++) {
+		PrimitiveObject line;
+		line.createLine(_pnts[i], _pnts[(i + 1) % _pnts.size()], col);
+		line.draw();
+	}
+}
+
+bool HotPolygon::contains(const Common::Point &pos) const {
+	bool result = false;
+	for (int i = 0, j = _pnts.size() - 1; i < (int)_pnts.size(); j = i++) {
+		if ((_pnts[i].y > pos.y) != (_pnts[j].y > pos.y) &&
+		    (pos.x < (_pnts[j].x - _pnts[i].x) * (pos.y - _pnts[i].y) / (_pnts[j].y - _pnts[i].y) + _pnts[i].x)) {
+			result = !result;
+		}
+	}
+	return result;
+}
+
+Common::Point HotPolygon::center() const {
+	if (_pnts.empty())
+		return Common::Point(0, 0);
+	int x = 0, y = 0;
+	for (uint i = 0; i < _pnts.size(); i++) {
+		x += _pnts[i].x;
+		y += _pnts[i].y;
+	}
+	return Common::Point(x / (int)_pnts.size(), y / (int)_pnts.size());
+}
+
+void HotPolygon::move(const Common::Point &c) {
+	Common::Point p = center();
+	Common::Point offset(c.x - p.x, c.y - p.y);
+	for (uint i = 0; i < _pnts.size(); i++)
+		_pnts[i] += offset;
+}
+
+void HotPolygon::fixBorders() {
+	const int FIX_BORDER = 6;
+	Common::Point c = center();
+	for (uint i = 0; i < _pnts.size(); i++) {
+		Common::Point &p = _pnts[i];
+		if (p.x <= FIX_BORDER && p.x < c.x) p.x = 0;
+		if (p.x >= kGameW - FIX_BORDER && p.x > c.x) p.x = kGameW;
+		if (p.y <= FIX_BORDER && p.y < c.y) p.y = 0;
+		if (p.y >= kGameH - FIX_BORDER && p.y > c.y) p.y = kGameH;
+	}
+}
