+bool SaveGame::hasSection(uint32 sectionTag) {
+	if (_saving || _currentSection != 0 || !_inSaveFile)
+		return false;
+	int64 start = _inSaveFile->pos();
+	bool found = false;
+	while (!_inSaveFile->eos()) {
+		uint32 tag = _inSaveFile->readUint32BE();
+		if (_inSaveFile->eos() || tag == SAVEGAME_FOOTERTAG)
+			break;
+		if (tag == sectionTag) {
+			found = true;
+			break;
+		}
+		uint32 size = _inSaveFile->readUint32BE();
+		_inSaveFile->seek(size, SEEK_CUR);
+	}
+	_inSaveFile->seek(start, SEEK_SET);
+	return found;
 }
 
