+
+// Grim Mouse: pointer and buttons. Returns true when the event was used.
+// Left: walk / use (twice within 500 ms: run), right: look, middle (or a right
+// click on Manny himself, for hosts with two buttons): the inventory.
+bool GrimEngine::handleMouseEvent(Common::Event &event) {
+	if (!_hotspotManager || _mode == SmushMode)
+		return false;
+	Common::EventType type = event.type;
+	if (type == Common::EVENT_MOUSEMOVE) {
+		_cursor->updatePosition(event.mouse);
+		_hotspotManager->hover(_cursor->getPosition());
+		return true;
+	}
+	if (type != Common::EVENT_LBUTTONDOWN && type != Common::EVENT_RBUTTONDOWN &&
+	    type != Common::EVENT_MBUTTONDOWN && type != Common::EVENT_WHEELUP && type != Common::EVENT_WHEELDOWN) {
+		return type == Common::EVENT_LBUTTONUP || type == Common::EVENT_RBUTTONUP || type == Common::EVENT_MBUTTONUP;
+	}
+	_cursor->updatePosition(event.mouse);
+	bool doubleClick = false;
+	if (type == Common::EVENT_LBUTTONDOWN) {
+		uint32 now = g_system->getMillis();
+		doubleClick = (now - _lastClick) < 500;
+		_lastClick = now;
+	}
+	bool inventory = type == Common::EVENT_MBUTTONDOWN ||
+	                 (type == Common::EVENT_LBUTTONDOWN && event.kbd.hasFlags(Common::KBD_CTRL));
+	if (type == Common::EVENT_RBUTTONDOWN && _hotspotManager->getCtrlMode() == HotspotMan::Normal &&
+	    !_hotspotManager->isDialog()) {
+		// On Manny (he stands in front of whatever is behind him): from his
+		// feet to the top of his head on screen, a quarter of that either side.
+		Common::Point feet = _hotspotManager->mannyPos2D(0.f), head = _hotspotManager->mannyPos2D(0.6f);
+		Common::Point p = _cursor->getPosition();
+		if (feet.x || feet.y) {
+			int top = MIN(feet.y, head.y) - 8, bottom = MAX(feet.y, head.y) + 4;
+			int cx = (feet.x + head.x) / 2;
+			inventory = p.y >= top && p.y <= bottom && ABS(p.x - cx) <= MAX(20, (bottom - top) / 4);
+			debug(1, "Grim Mouse: right click %d,%d; Manny %d,%d-%d,%d%s", p.x, p.y, feet.x, feet.y, head.x, head.y, inventory ? ": inventory" : "");
+		}
+	}
+	if (inventory) {
+		Common::KeyState kbd(Common::KEYCODE_i, 'i');
+		handleChars(Common::EVENT_KEYDOWN, kbd);
+		handleControls(Common::EVENT_KEYDOWN, kbd);
+		handleControls(Common::EVENT_KEYUP, kbd);
+		return true;
+	}
+	_hotspotManager->event(_cursor->getPosition(), event, doubleClick);
+	return true;
 }
 
