+
+// ---- Camera, renderer independent ----------------------------------------
+//
+// Grim's sets use Set::Setup::setupCamera(): a frustum of _fov (horizontal,
+// degrees), aspect 4:3, near 0.01, far 3276.8; a look-at from _pos to
+// _interest with up = +z (+y when looking straight down), then a roll about
+// the view axis. This is what GfxOpenGLS/GfxOpenGL/GfxTinyGL all build, so the
+// projection is done here once instead of in every renderer (Grim Mouse had it
+// in the OpenGL renderers only, which is why TinyGL never worked there).
+
+struct GrimCamera {
+	Math::Vector3d pos, s, u, f;
+	float tanX, cr, sr;
+};
+
+static bool currentCamera(GrimCamera &cam) {
+	Set *set = g_grim->getCurrSet();
+	if (!set)
+		return false;
+	Set::Setup *setup = set->getCurrSetup();
+	if (!setup)
+		return false;
+	cam.pos = setup->_pos;
+	const Math::Vector3d &interest = setup->_interest;
+	Math::Vector3d up(0, 0, 1);
+	if (cam.pos.x() == interest.x() && cam.pos.y() == interest.y())
+		up = Math::Vector3d(0, 1, 0);
+	cam.f = (interest - cam.pos).getNormalized();
+	cam.s = Math::Vector3d::crossProduct(cam.f, up).getNormalized();
+	cam.u = Math::Vector3d::crossProduct(cam.s, cam.f);
+	cam.tanX = tan(setup->_fov / 2 * (float)M_PI / 180.f);
+	Math::Angle roll(setup->_roll);
+	cam.cr = roll.getCosine();
+	cam.sr = roll.getSine();
+	return cam.tanX > 0;
+}
+
+bool HotspotMan::worldToScreen(const Math::Vector3d &p, int &x, int &y) {
+	GrimCamera cam;
+	if (!currentCamera(cam))
+		return false;
+	Math::Vector3d d = p - cam.pos;
+	float ex = cam.s.dotProduct(d), ey = cam.u.dotProduct(d), depth = cam.f.dotProduct(d);
+	if (depth <= 0.f)
+		return false;
+	// roll, as makeRotationMatrix(roll, z) in GfxOpenGLS
+	float rx = cam.cr * ex + cam.sr * ey;
+	float ry = -cam.sr * ex + cam.cr * ey;
+	float nx = rx / depth / cam.tanX;
+	float ny = ry / depth / (0.75f * cam.tanX);
+	float wx = (nx + 1.f) * 0.5f * kGameW;
+	float wy = kGameH - (ny + 1.f) * 0.5f * kGameH;
+	wx = CLIP<float>(wx, 0, kGameW - 1);
+	wy = CLIP<float>(wy, 0, kGameH - 1);
+	x = (int)wx;
+	y = (int)wy;
+	return x > 0 && y > 0 && x < kGameW - 1 && y < kGameH - 1;
+}
+
+bool HotspotMan::raycast(int x, int y, Math::Vector3d &r0, Math::Vector3d &r1) {
+	GrimCamera cam;
+	if (!currentCamera(cam))
+		return false;
+	float nx = 2.f * (x + 0.5f) / kGameW - 1.f;
+	float ny = 2.f * (kGameH - y - 0.5f) / kGameH - 1.f;
+	float rx = nx * cam.tanX, ry = ny * 0.75f * cam.tanX;
+	float ex = cam.cr * rx - cam.sr * ry;
+	float ey = cam.sr * rx + cam.cr * ry;
+	Math::Vector3d dir = cam.s * ex + cam.u * ey + cam.f;
+	// Same shape as gluUnProject at z=0 and z=1: r0 on the near plane, r1 the
+	// whole ray to the far plane (freeClick nudges both down a little at a time).
+	const float nclip = 0.01f, fclip = 3276.8f;
+	r0 = cam.pos + dir * nclip;
+	r1 = dir * (fclip - nclip);
+	return true;
+}
