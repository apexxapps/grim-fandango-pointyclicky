+// PointyClicky Edition (16 Nov 2026, the proof playthrough): a character's
+// outline is still its own while the character is drawn there, the box it's
+// drawn in overlapping the outline. Lupe behind the coat check counter is
+// drawn mostly hidden by it (a small box low in the window), and with only the
+// box live a tap on the window, where the 1998 U found her, walked instead.
+// Once a character has walked off from its outline, its outline takes no taps
+// (the stale place that "as drawn" was made for).
+bool HotspotMan::actorAway(int oid, const HotPolygon &region) {
+	Actor *a = liveActor(oid);
+	if (!a)
+		return false;
+	if (region._pnts.empty())
+		return true;
+	Common::Rect r(region._pnts[0].x, region._pnts[0].y, region._pnts[0].x + 1, region._pnts[0].y + 1);
+	for (uint i = 1; i < region._pnts.size(); i++)
+		r.extend(Common::Rect(region._pnts[i].x, region._pnts[i].y, region._pnts[i].x + 1, region._pnts[i].y + 1));
+	return !r.intersects(a->_screenBox);
+}
+
+// The forklift as drawn, more closely than its box: the outline of its body
+// (0.45 behind its centre to its fork tips 0.6 ahead, 0.3 either side, the
+// floor to the top of its mast) on screen. Seen from above in the elevator its
+// screen box covered the floor round it and the grating Manny walks out by
+// (proof playthrough, 15 Nov 2026).
+static bool onForkliftBody(Actor *a, const Common::Point &p) {
+	float yr = a->getYaw().getRadians();
+	Math::Vector3d c = a->getPos(), fwd(-sinf(yr), cosf(yr), 0.f), side(cosf(yr), sinf(yr), 0.f);
+	Common::Array<Common::Point> pts;
+	for (int i = 0; i < 8; i++) {
+		Math::Vector3d w = c + fwd * ((i & 1) ? 0.6f : -0.45f) + side * ((i & 2) ? 0.3f : -0.3f) +
+		                   Math::Vector3d(0.f, 0.f, (i & 4) ? 1.1f : 0.f);
+		int x, y;
+		if (!HotspotMan::worldToScreen(w, x, y))
+			return true;   // not all on screen: its box, as before
+		pts.push_back(Common::Point(x, y));
+	}
+	// the convex hull of the eight (monotone chain), then p inside it
+	Common::sort(pts.begin(), pts.end(), [](const Common::Point &l, const Common::Point &r) {
+		return l.x < r.x || (l.x == r.x && l.y < r.y);
+	});
+	auto cross = [](const Common::Point &o, const Common::Point &q, const Common::Point &r) {
+		return (long)(q.x - o.x) * (r.y - o.y) - (long)(q.y - o.y) * (r.x - o.x);
+	};
+	Common::Array<Common::Point> h;
+	for (int pass = 0; pass < 2; pass++) {
+		uint start = h.size();
+		for (uint k = 0; k < pts.size(); k++) {
+			const Common::Point &q = pass ? pts[pts.size() - 1 - k] : pts[k];
+			while (h.size() >= start + 2 && cross(h[h.size() - 2], h[h.size() - 1], q) <= 0)
+				h.pop_back();
+			h.push_back(q);
+		}
+		h.pop_back();
+	}
+	if (h.size() < 3)
+		return true;
+	for (uint k = 0; k < h.size(); k++)
+		if (cross(h[k], h[(k + 1) % h.size()], p) < 0)
+			return false;
+	return true;
+}
