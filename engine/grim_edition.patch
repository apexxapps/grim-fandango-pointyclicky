+// PointyClicky Edition: NoticeHotspot(id), called by mouse.lua each time the
+// game's Head_Control turns Manny's head to an object (hot_object).
+void Lua_V1::NoticeHotspot() {
+	HotspotMan *hm = hotspots();
+	if (!hm)
+		return;
+	if (HotObject *hs = hm->getObject((int)lua_getnumber(lua_getparam(1))))
+		hs->_noticed = true;
+}
