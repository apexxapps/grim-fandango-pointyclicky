+// PointyClicky Edition: a save holds the whole Lua state, globals included, and
+// names each C function by its place in the opcode tables. So after a load the
+// Grim Mouse opcodes are set again by name: one added since the save exists,
+// and none is bound to a neighbour's function if the table changed.
+void Lua_V1::restoreMouseOpcodes() {
+	static const luaL_reg mouseOpcodes[] = {
+		{ "RegisterHotspot", LUA_OPCODE(Lua_V1, RegisterHotspot) },
+		{ "ActivateHotspot", LUA_OPCODE(Lua_V1, ActivateHotspot) },
+		{ "NoticeHotspot", LUA_OPCODE(Lua_V1, NoticeHotspot) },
+		{ "UpdateHotspot", LUA_OPCODE(Lua_V1, MouseUpdateHotspot) },
+		{ "SwitchControlMode", LUA_OPCODE(Lua_V1, SwitchControlMode) },
+		{ "NotifyWalk", LUA_OPCODE(Lua_V1, NotifyWalk) },
+		{ "RegisterInventory", LUA_OPCODE(Lua_V1, RegisterInventory) },
+		{ "MouseDown", LUA_OPCODE(Lua_V1, MouseDown) },
+		{ "InteractMode", LUA_OPCODE(Lua_V1, InteractMode) },
+		{ "RenameHotspot", LUA_OPCODE(Lua_V1, RenameHotspot) },
+		{ "GetControlMode", LUA_OPCODE(Lua_V1, GetControlMode) },
+		{ "SetOptionMode", LUA_OPCODE(Lua_V1, SetOptionMode) },
+		{ "LinkHotspotActor", LUA_OPCODE(Lua_V1, LinkHotspotActor) },
+	};
+	lua_beginblock();
+	for (uint i = 0; i < ARRAYSIZE(mouseOpcodes); i++)
+		lua_register(mouseOpcodes[i].name, mouseOpcodes[i].func);
+	lua_endblock();
+}
