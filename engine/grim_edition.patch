+// ---- The vehicles: tap where to go ------------------------------------------
+//
+// PointyClicky Edition (docs/moments.md, line 1; for Simon to try, 15 Nov 2026).
+// The Bone Wagon is driven by the game's own bone_wagon_button_handler, from
+// the 1998 keys: Up gas, Down reverse, Left/Right steer (read every frame by
+// bonewagon.monitor_turns, which turns the wagon while one is held), U or P
+// get out. A tap only decides which of those keys are held and for how long:
+// the engine holds them as a player would and lets go when the wagon is there.
+// No object, no script and no walk of the edition's moves the wagon.
+
+static const Common::KeyCode kDriveKeyCodes[] = {
+	Common::KEYCODE_UP, Common::KEYCODE_DOWN, Common::KEYCODE_LEFT, Common::KEYCODE_RIGHT
+};
+static const float kDriveArrive = 1.2f;       // there: its nose (or tail) at the point tapped (world units)
+static const float kDrivePassed = 2.f;        // ... or this close and the point is now behind
+static const float kDriveWaypoint = 1.5f;     // a waypoint on the way: this close, on to the next
+static const float kDriveSteer = 6.f;         // steer while it is off by more (degrees)
+static const float kDriveThrottle = 70.f;     // gas (or reverse) only while it is off by less
+static const float kDriveBehind = 120.f;      // a tap this far round from the nose is "behind" ...
+static const float kDriveNearExit = 1.5f;     // a tap this near a way out is on it
+static const float kDriveBackUp = 5.f;        // ... and backed up to if it's no further than this
+static const uint32 kDriveTimeout = 25000;    // never longer than this (ms)
+static const uint32 kDriveStall = 1200;       // blocked: in this long, neither moved ...
+static const float kDriveStallMove = 0.05f;   // ... this far
+static const float kDriveStallTurn = 3.f;     // ... nor turned this much (degrees)
+
+static float angleDiff(float a) {
+	while (a > 180.f)
+		a -= 360.f;
+	while (a <= -180.f)
+		a += 360.f;
+	return a;
+}
+
+bool HotspotMan::vehicleHandlerOn() {
+	return LuaBase::instance()->queryVariable(
+		"(bone_wagon_button_handler ~= nil and system.buttonHandler == bone_wagon_button_handler)", false) > 0;
+}
+
+// The wagon is the selected actor while Manny drives it (bonewagon:set_selected()).
+Actor *HotspotMan::vehicle() {
+	Actor *a = g_grim->getSelectedActor();
+	return a && a->getName() == "Bone Wagon" ? a : nullptr;
+}
+
+// Where a tap lands on the ground: the first walk sector the ray meets (as a
+// walk tap does), else the plane the wagon stands on. On one of the set's
+// ways out (a hot sector: the game's Doorman sends the object's walkOut when
+// the driven actor enters it), exit is set.
+bool HotspotMan::groundPoint(const Common::Point &cursor, float z, Math::Vector3d &out, bool &exit) {
+	exit = false;
+	Math::Vector3d r0, r1;
+	if (!raycast(cursor.x, cursor.y, r0, r1))
+		return false;
+	Set *set = g_grim->getCurrSet();
+	float best = -1.f, bestHot = -1.f;
+	Math::Vector3d hot;
+	for (int s = 0; s < set->getSectorCount(); s++) {
+		Sector *sector = set->getSectorBase(s);
+		bool isHot = sector->getType() == Sector::HotType;
+		if (((sector->getType() & Sector::WalkType) != Sector::WalkType && !isHot) || !sector->isVisible())
+			continue;
+		Math::Vector3d v;
+		if (!sector->raycast(r0, r1, v) || !sector->isPointInSector(v))
+			continue;
+		float d = (v - r0).getMagnitude();
+		float &b = isHot ? bestHot : best;
+		if (b < 0 || d < b) {
+			b = d;
+			(isHot ? hot : out) = v;
+		}
+	}
+	if (bestHot >= 0) {
+		out = hot;
+		exit = true;
+		return true;
+	}
+	if (best < 0) {
+		if (fabs(r1.z()) < 1e-6f)
+			return false;
+		float t = (z - r0.z()) / r1.z();
+		if (t <= 0.f)
+			return false;
+		out = r0 + r1 * t;
+	}
+	// A way out is often a sliver at the edge of the screen: a tap just short
+	// of one counts as on it (aimed well inside it, towards its middle).
+	float nearest = kDriveNearExit;
+	for (int s = 0; s < set->getSectorCount(); s++) {
+		Sector *sector = set->getSectorBase(s);
+		if (sector->getType() != Sector::HotType || !sector->isVisible() || sector->getNumVertices() < 3)
+			continue;
+		Math::Vector3d c = sector->getClosestPoint(out), mid;
+		float d = (c - out).getMagnitude();
+		if (d >= nearest)
+			continue;
+		for (int i = 0; i < sector->getNumVertices(); i++)
+			mid += sector->getVertices()[i];
+		mid /= (float)sector->getNumVertices();
+		Math::Vector3d in = mid - c;
+		float len = in.getMagnitude();
+		nearest = d;
+		hot = len > 2.f ? c + in * (2.f / len) : mid;
+		exit = true;
+	}
+	if (exit)
+		out = hot;
+	return true;
+}
+
+void HotspotMan::driveKey(int key, bool down) {
+	if (_driveHeld[key] == down)
+		return;
+	_driveHeld[key] = down;
+	g_grim->holdGameKey(kDriveKeyCodes[key], down);
+}
+
+void HotspotMan::driveStop(const char *why, bool release) {
+	if (!_driving)
+		return;
+	for (int i = 0; i < kDriveKeys; i++) {
+		if (release)
+			driveKey(i, false);
+		_driveHeld[i] = false;
+	}
+	_driving = false;
+	debug(1, "Grim Mouse: drive ends (%s)", why);
+}
+
+bool HotspotMan::driveEvent(const Common::Event &ev, const Common::Point &cursor) {
+	if (ev.type != Common::EVENT_LBUTTONDOWN && ev.type != Common::EVENT_RBUTTONDOWN)
+		return false;
+	if (!g_grim->getCurrSet() || !vehicleHandlerOn())
+		return false;
+	// the handler is the wagon's: no tap goes anywhere else (the walk taps
+	// would steer it by the scripts' own walks), and none in a cut scene
+	if (_cutScene > 0)
+		return true;
+	Actor *wagon = vehicle();
+	if (!wagon)
+		return true;
+	if (ev.type == Common::EVENT_RBUTTONDOWN || ev.kbd.hasFlags(Common::KBD_ALT)) {
+		driveStop("look");
+		g_grim->pressGameKey(Common::KEYCODE_e, 'e');
+		return true;
+	}
+	// on the wagon, as it is drawn: U, get out
+	wagon->_screenBoxWanted = true;
+	if (!wagon->_screenBox.isEmpty() && g_system->getMillis() - wagon->_screenBoxTime < 250 &&
+	    wagon->_screenBox.contains(cursor)) {
+		driveStop("tap on the wagon");
+		g_grim->pressGameKey(Common::KEYCODE_u, 'u');
+		debug(1, "Grim Mouse: tap on the Bone Wagon %d,%d: U", cursor.x, cursor.y);
+		return true;
+	}
+	Math::Vector3d target;
+	bool exit;
+	if (!groundPoint(cursor, wagon->getPos().z(), target, exit))
+		return true;
+	// the way there: the game's own route through the sectors the wagon may
+	// use (as a walk would take it), the point itself if there is none
+	Common::List<Math::Vector3d> path;
+	Math::Vector3d dest;
+	if (wagon->findPath(target, path, dest))
+		path.push_front(exit ? target : dest);   // a way out: into it, not to the nearest walk sector
+	else {
+		path.clear();
+		path.push_back(target);
+	}
+	float off = angleDiff(wagon->getYawTo(path.back()).getDegrees() - wagon->getYaw().getDegrees());
+	bool wasDriving = _driving;
+	_driving = true;
+	// behind it and near: back up (a long way round is driven forwards)
+	Math::Vector3d away = path.front() - wagon->getPos();
+	away.z() = 0;
+	_driveReverse = fabs(off) > kDriveBehind && away.getMagnitude() < kDriveBackUp;
+	_driveExit = exit;
+	_drivePath = path;
+	_driveTarget = path.front();
+	_driveSet = g_grim->getCurrSet()->getName();
+	_driveStart = _driveCheckTime = g_system->getMillis();
+	_driveCheckPos = wagon->getPos();
+	_driveCheckYaw = wagon->getYaw().getDegrees();
+	// a new tap mid-drive: the keys held now that the new target doesn't want
+	// are let go by the next update
+	debug(1, "Grim Mouse: drive %s to %.2f,%.2f%s (tap %d,%d, %.0f deg off, %d waypoints)%s", _driveReverse ? "back" : "on",
+	      _driveTarget.x(), _driveTarget.y(), exit ? ", a way out" : "", cursor.x, cursor.y, off, _drivePath.size(),
+	      wasDriving ? ", re-targeted" : "");
+	driveUpdate();
+	return true;
+}
+
+void HotspotMan::driveUpdate() {
+	if (!_driving)
+		return;
+	Set *set = g_grim->getCurrSet();
+	if (!set || set->getName() != _driveSet)
+		return driveStop("the scene changed");
+	if (g_grim->getMode() != GrimEngine::NormalMode)
+		return driveStop("not in play");
+	if (_cutScene > 0)
+		return driveStop("cut scene");
+	if (!vehicleHandlerOn())
+		return driveStop("out of the wagon");
+	Actor *wagon = vehicle();
+	if (!wagon)
+		return driveStop("no wagon");
+	uint32 now = g_system->getMillis();
+	if (now - _driveStart > kDriveTimeout)
+		return driveStop("took too long");
+
+	Math::Vector3d pos = wagon->getPos();
+	float yaw = wagon->getYaw().getDegrees();
+	// how far the wagon must turn to the next waypoint: its nose to it, or
+	// going back, its tail; a waypoint reached (or passed) gives the next
+	float off = 0.f, dist = 0.f;
+	for (;;) {
+		Math::Vector3d d = _drivePath.back() - pos;
+		d.z() = 0;
+		dist = d.getMagnitude();
+		off = angleDiff(wagon->getYawTo(_drivePath.back()).getDegrees() + (_driveReverse ? 180.f : 0.f) - yaw);
+		if (_drivePath.size() == 1 || !(dist < kDriveWaypoint || (dist < 2 * kDriveWaypoint && fabs(off) > 90.f)))
+			break;
+		_drivePath.pop_back();
+	}
+	debug(3, "Grim Mouse: drive t=%u at %.2f,%.2f yaw %.0f, %.0f deg off, %.2f to go, %d waypoints, keys %d%d%d%d",
+	      now - _driveStart, pos.x(), pos.y(), yaw, off, dist, _drivePath.size(),
+	      _driveHeld[0], _driveHeld[1], _driveHeld[2], _driveHeld[3]);
+	// (on a way out, "there" is well inside it: by then the game has taken the
+	// scene away, or it had something to say instead: Glottis won't go yet)
+	if (_drivePath.size() == 1 && dist < (_driveExit ? kDriveArrive / 3 : kDriveArrive))
+		return driveStop("there");
+	if (_drivePath.size() == 1 && !_driveExit && dist < kDrivePassed && fabs(off) > 100.f)
+		return driveStop("went past it");
+
+	if (now - _driveCheckTime >= kDriveStall) {
+		Math::Vector3d moved = pos - _driveCheckPos;
+		moved.z() = 0;
+		if (moved.getMagnitude() < kDriveStallMove && fabs(angleDiff(yaw - _driveCheckYaw)) < kDriveStallTurn)
+			return driveStop(_drivePath.size() == 1 && dist < 2 * kDrivePassed ? "as near as it gets" : "blocked");
+		_driveCheckTime = now;
+		_driveCheckPos = pos;
+		_driveCheckYaw = yaw;
+	}
+
+	// The throttle: Up (or Down going back) while roughly facing the point; let
+	// go to turn tighter. The game starts its gas script on the key going down
+	// and runs it while the key is held; once that script has rolled to a stop,
+	// holding on does nothing, so the key goes up and down again, as a player's would.
+	int gas = _driveReverse ? kDriveDown : kDriveUp;
+	driveKey(_driveReverse ? kDriveUp : kDriveDown, false);
+	bool wantGas = fabs(off) < kDriveThrottle;
+	if (wantGas && _driveHeld[gas]) {
+		bool running = LuaBase::instance()->queryVariable(_driveReverse ? "(find_script(bonewagon.reverse) ~= nil)" :
+		                                                  "(find_script(bonewagon.gas) ~= nil)", false) > 0;
+		if (!running)
+			driveKey(gas, false);
+	}
+	driveKey(gas, wantGas);
+
+	// The steering: which arrow turns the wagon the way it must go, by the
+	// rule of the game's own bonewagon.monitor_turns: rolling forward Left
+	// turns it left, rolling back Left turns it right, standing still Left
+	// turns it left on the spot.
+	if (fabs(off) <= kDriveSteer) {
+		driveKey(kDriveLeft, false);
+		driveKey(kDriveRight, false);
+	} else {
+		int st = LuaBase::instance()->queryVariable(
+			"(((bonewagon.turn_rate > 1) and 1 or 0) + ((bonewagon.walk_rate > 0) and 2 or 0))", false);
+		bool rolling = (st & 1) != 0, forward = (st & 2) != 0 || _driveHeld[kDriveUp];
+		bool leftTurnsLeft = !rolling || forward;
+		bool wantLeft = (off > 0) == leftTurnsLeft;   // a positive yaw is a turn to the left
+		driveKey(wantLeft ? kDriveRight : kDriveLeft, false);
+		driveKey(wantLeft ? kDriveLeft : kDriveRight, true);
+	}
+}
+
 } // end of namespace Grim
