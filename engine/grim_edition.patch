+void Lua_V1::LinkHotspotActor() {
+	HotspotMan *hm = hotspots();
+	if (!hm)
+		return;
+	HotObject *hs = hm->getObject((int)lua_getnumber(lua_getparam(1)));
+	lua_Object actorObj = lua_getparam(2);
+	if (!hs || !lua_isuserdata(actorObj) || lua_tag(actorObj) != MKTAG('A','C','T','R'))
+		return;
+	Actor *actor = getactor(actorObj);
+	hs->_actor = actor ? actor->getId() : 0;
+}
