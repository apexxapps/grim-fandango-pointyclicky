+	Common::Point feet = mannyPos2D(0.f), head = mannyPos2D(0.6f);
+	if (!feet.x && !feet.y)
+		return false;
+	int top = MIN(feet.y, head.y) - 8, bottom = MAX(feet.y, head.y) + 4, cx = (feet.x + head.x) / 2;
+	bool on = p.y >= top && p.y <= bottom && ABS(p.x - cx) <= MAX(20, (bottom - top) / 4);
+	if (on && drawn) {
+		// and where he's drawn, and at the height of his head only his head (a
+		// thing beside his head, over his shoulder, is that thing)
+		const Common::Rect &b = manny->_screenBox;
+		on = b.contains(p);
+		if (on && p.y < b.top + b.height() * 22 / 100 && ABS(p.x - head.x) > MAX(16, b.width() / 6))
+			on = false;
+	}
+	if (!on)
+		return false;
+	int ooid = outlineObjectAt(p, g_grim->getCurrSet()->getSetup());
+	if (ooid > 0 && cameraDepth(_hotobject[ooid]._pos) < cameraDepth(manny->getPos()))
+		return false;
+	return true;
+}
