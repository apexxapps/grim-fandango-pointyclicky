+Actor *HotspotMan::liveActor(int oid) {
+	if (oid <= 0 || oid >= (int)_hotobject.size() || !_hotobject[oid]._actor)
+		return nullptr;
+	Actor *a = Actor::getPool().getObject(_hotobject[oid]._actor);
+	Set *set = g_grim->getCurrSet();
+	if (!a || !set)
+		return nullptr;
+	a->_screenBoxWanted = true;   // measured from the next frame on
+	if (!a->isVisible() || !a->isInSet(set->getName()) || a->_screenBox.isEmpty() ||
+	    g_system->getMillis() - a->_screenBoxTime > 250)
+		return nullptr;
+	// Behind the camera it isn't on screen, and its box is a mirror image
+	// (the proof playthrough: the Bone Wagon parked behind the tree pump's
+	// camera took the taps on the wheelbarrow, across the screen from it).
+	if (cameraDepth(a->getWorldPos()) <= 0.f)
+		return nullptr;
+	return a;
+}
