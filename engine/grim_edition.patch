+// The touchable character under the pointer (the nearest, if several); -1 if none.
+int HotspotMan::actorAt(const Common::Point &p, float &depth) {
+	int best = -1;
+	for (uint i = 1; i < _hotobject.size(); i++) {
+		if (!_hotobject[i]._active && !_hotobject[i]._alwaysLive)
+			continue;
+		Actor *a = liveActor(i);
+		if (!a || !a->_screenBox.contains(p))
+			continue;
+		if (a->getName() == "forklift" && !onForkliftBody(a, p))
+			continue;
+		float d = cameraDepth(a->getWorldPos());
+		if (best < 0 || d < depth) {
+			best = i;
+			depth = d;
+		}
+	}
+	return best;
+}
+
+// The game's object under the pointer by its outline, in the normal mode, as
+// event() would take it (the first match); -1 if none.
+int HotspotMan::outlineObjectAt(const Common::Point &p, int setup) {
+	Common::Array<MouseHotspot> &hotspots = hotspotsOf(activeSet());
+	for (uint i = 0; i < hotspots.size(); i++) {
+		MouseHotspot &hs = hotspots[i];
+		int gid = hs._objId;
+		if (hs._setup != setup || hs._type >= 10 || hs._type == 3 || !hs._region.contains(p))
+			continue;
+		if (gid <= 0 || gid >= (int)_hotobject.size() || !_hotobject[gid]._active || actorAway(gid, hs._region))
+			continue;
+		return gid;
+	}
+	return -1;
+}
