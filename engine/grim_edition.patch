+// ---- The vehicles: tap where to go ------------------------------------------
+//
+// PointyClicky Edition (docs/moments.md, lines 1-5; Simon, 15 Nov 2026: "the
+// point and click just works"). While the game's own key handler for a vehicle
+// is installed, a tap decides which of the 1998 keys are held and for how
+// long, and nothing else: the engine holds them as a player would, along the
+// game's own route, and lets go when the vehicle is there, blocked, in a cut
+// scene, after the scene changes or on a new tap (which re-targets). No
+// object, no script and no walk of the edition's moves a vehicle.
+//
+//   the Bone Wagon (bone_wagon_button_handler: sg, na, tr, bv, lb, bd) and the
+//   forklift (forklift_button_handler: de, wc) drive anywhere: Up gas (Down
+//   reverse for a near point behind) and the arrow that turns it;
+//   Glottis's ride through the albinizod tunnel (at_bw_handler) runs along the
+//   tunnel: Up forward, Down back;
+//   the crane (ew.buttonHandler) runs along its track: Left towards the
+//   crusher, Right back to the conveyor; a tap on the crane lowers or raises it;
+//   the ship's engine (engineButtonHandler) keeps its levers: each tap is one
+//   press, as each key press was one drive_ship.
+
+static const Common::KeyCode kDriveKeyCodes[] = {
+	Common::KEYCODE_UP, Common::KEYCODE_DOWN, Common::KEYCODE_LEFT, Common::KEYCODE_RIGHT
+};
+
+// Distances in world units, for the vehicle's own scale.
+struct DriveScale {
+	float arrive;      // there: its nose (or tail) this near the point tapped
+	float passed;      // ... or this near and the point is now behind
+	float waypoint;    // a waypoint on the way: this near, on to the next
+	float backUp;      // a point behind and no further than this is backed up to
+	float nearExit;    // a tap this near a way out is on it
+	float stallMove;   // blocked: in kDriveStall, it moved less than this ...
+	uint32 timeout;    // never longer than this (ms)
+};
+static const DriveScale kWagonScale    = { 1.2f, 2.0f, 1.5f, 5.0f, 1.5f, 0.05f, 25000 };
+// the forklift crawls (0.4 a second, 30 degrees a second) in a small cellar,
+// and in the elevator has a box of 0.6 by 0.7 to move in and two lanes 0.07
+// wide to line up with (de.lua's fork_box2/3): it goes where it's tapped to
+// within a few centimetres, and a tap only on a way out is one
+static const DriveScale kForkliftScale = { 0.06f, 0.15f, 0.12f, 1.5f, 0.08f, 0.005f, 45000 };
+
+static const float kDriveSteer = 6.f;         // steer while it is off by more (degrees)
+static const float kDriveThrottle = 70.f;     // gas (or reverse) only while it is off by less
+static const float kDriveBehind = 120.f;      // a tap this far round from the nose is "behind"
+static const uint32 kDriveStall = 1200;       // blocked: in this long, neither moved ...
+static const float kDriveStallTurn = 3.f;     // ... nor turned this much (degrees)
+static const float kTunnelArrive = 0.25f;     // the tunnel: there, along it
+static const uint32 kTunnelTimeout = 30000;
+static const int kCraneReach = 70;            // a tap this near the track (pixels) is on it
+static const int kCraneOnPoint = 14;          // ... this near a point: on the track, even over the crane
+static const uint32 kCraneTimeout = 40000;
+static const uint32 kCraneStall = 6000;       // no point passed in this long: stuck
+
+static float angleDiff(float a) {
+	while (a > 180.f)
+		a -= 360.f;
+	while (a <= -180.f)
+		a += 360.f;
+	return a;
+}
+
+// A number the game's Lua gives back (0 if it isn't one).
+static float luaNumber(const Common::String &expr) {
+	lua_beginblock();
+	lua_dostring(("return " + expr).c_str());
+	lua_Object o = lua_getresult(1);
+	float v = lua_isnumber(o) ? lua_getnumber(o) : 0.f;
+	lua_endblock();
+	return v;
+}
+
+static bool luaTrue(const Common::String &expr) {
+	return luaNumber("((" + expr + ") and 1 or 0)") > 0.5f;
+}
+
+// The actor of one of the game's Lua actor tables (glottis, ew.crane_actor).
+static Actor *luaActor(const Common::String &table) {
+	lua_beginblock();
+	lua_dostring(("return " + table + " and " + table + ".hActor").c_str());
+	lua_Object o = lua_getresult(1);
+	Actor *a = nullptr;
+	if (lua_isuserdata(o) && lua_tag(o) == MKTAG('A', 'C', 'T', 'R'))
+		a = Actor::getPool().getObject(lua_getuserdata(o));
+	lua_endblock();
+	return a;
+}
+
+static Math::Vector3d luaPoint(const Common::String &x, const Common::String &y, const Common::String &z) {
+	return Math::Vector3d(luaNumber(x), luaNumber(y), luaNumber(z));
+}
+
+// Which vehicle's handler the game has installed (kNoVehicle if none).
+int HotspotMan::vehicleKind() {
+	return (int)luaNumber(
+		"((bone_wagon_button_handler ~= nil and system.buttonHandler == bone_wagon_button_handler) and 1) or "
+		"((forklift_button_handler ~= nil and system.buttonHandler == forklift_button_handler) and 2) or "
+		"((at_bw_handler ~= nil and system.buttonHandler == at_bw_handler) and 3) or "
+		"((ew ~= nil and ew.buttonHandler ~= nil and system.buttonHandler == ew.buttonHandler) and 4) or "
+		"((engineButtonHandler ~= nil and system.buttonHandler == engineButtonHandler) and 5) or 0");
+}
+
+static const char *const kVehicleNames[] = { "", "Bone Wagon", "forklift", "tunnel ride", "crane", "ship's engine" };
+
+// The actor that is the vehicle: the selected one while Manny drives the Bone
+// Wagon (bonewagon:set_selected()) or the forklift (de.forklift_actor:mount);
+// Glottis's wagon in the tunnel; the crane.
+Actor *HotspotMan::vehicle(int kind) {
+	if (kind == kWagon || kind == kForklift) {
+		Actor *a = g_grim->getSelectedActor();
+		return a && a->getName() == (kind == kWagon ? "Bone Wagon" : "forklift") ? a : nullptr;
+	}
+	if (kind == kTunnel)
+		return luaActor("glottis");
+	if (kind == kCrane)
+		return luaActor("ew.crane_actor");
+	return nullptr;
+}
+
+// The vehicle as it is drawn this frame contains p.
+static bool onActor(Actor *a, const Common::Point &p) {
+	if (!a)
+		return false;
+	a->_screenBoxWanted = true;
+	return !a->_screenBox.isEmpty() && g_system->getMillis() - a->_screenBoxTime < 250 && a->_screenBox.contains(p) &&
+	       HotspotMan::cameraDepth(a->getWorldPos()) > 0.f;   // (behind the camera: not drawn)
+}
+
+// Where a tap lands on the ground: the first walk sector the ray meets (as a
+// walk tap does), else the plane the vehicle stands on. On one of the set's
+// ways out (a hot sector: the game's Doorman sends the object's walkOut when
+// the driven actor enters it), exit is set.
+bool HotspotMan::groundPoint(const Common::Point &cursor, float z, float nearExit, Math::Vector3d &out, bool &exit) {
+	exit = false;
+	Math::Vector3d r0, r1;
+	if (!raycast(cursor.x, cursor.y, r0, r1))
+		return false;
+	Set *set = g_grim->getCurrSet();
+	float best = -1.f, bestHot = -1.f;
+	Math::Vector3d hot;
+	for (int s = 0; s < set->getSectorCount(); s++) {
+		Sector *sector = set->getSectorBase(s);
+		bool isHot = sector->getType() == Sector::HotType;
+		if (((sector->getType() & Sector::WalkType) != Sector::WalkType && !isHot) || !sector->isVisible())
+			continue;
+		Math::Vector3d v;
+		if (!sector->raycast(r0, r1, v) || !sector->isPointInSector(v))
+			continue;
+		float d = (v - r0).getMagnitude();
+		float &b = isHot ? bestHot : best;
+		if (b < 0 || d < b) {
+			b = d;
+			(isHot ? hot : out) = v;
+		}
+	}
+	if (bestHot >= 0) {
+		out = hot;
+		exit = true;
+		return true;
+	}
+	if (best < 0) {
+		if (fabs(r1.z()) < 1e-6f)
+			return false;
+		float t = (z - r0.z()) / r1.z();
+		if (t <= 0.f)
+			return false;
+		out = r0 + r1 * t;
+	}
+	// A way out is often a sliver at the edge of the screen: a tap just short
+	// of one counts as on it (aimed well inside it, towards its middle).
+	float nearest = nearExit;
+	for (int s = 0; s < set->getSectorCount(); s++) {
+		Sector *sector = set->getSectorBase(s);
+		if (sector->getType() != Sector::HotType || !sector->isVisible() || sector->getNumVertices() < 3)
+			continue;
+		Math::Vector3d c = sector->getClosestPoint(out), mid;
+		float d = (c - out).getMagnitude();
+		if (d >= nearest)
+			continue;
+		for (int i = 0; i < sector->getNumVertices(); i++)
+			mid += sector->getVertices()[i];
+		mid /= (float)sector->getNumVertices();
+		Math::Vector3d in = mid - c;
+		float len = in.getMagnitude();
+		nearest = d;
+		hot = len > nearExit * 1.33f ? c + in * (nearExit * 1.33f / len) : mid;
+		exit = true;
+	}
+	if (exit)
+		out = hot;
+	return true;
+}
+
+void HotspotMan::driveKey(int key, bool down) {
+	if (_driveHeld[key] == down)
+		return;
+	_driveHeld[key] = down;
+	if (down)
+		_drivePressTime = g_system->getMillis();
+	g_grim->holdGameKey(kDriveKeyCodes[key], down);
+}
+
+void HotspotMan::driveStop(const char *why, bool release) {
+	if (!_driving)
+		return;
+	for (int i = 0; i < kDriveKeys; i++) {
+		if (release)
+			driveKey(i, false);
+		_driveHeld[i] = false;
+	}
+	_driving = false;
+	debug(1, "Grim Mouse: %s: drive ends (%s)", kVehicleNames[_driveKind], why);
+}
+
+// One key, pressed and let go, as the 1998 player pressed it.
+static void pressKey(Common::KeyCode code, uint16 ascii, const char *what) {
+	g_grim->pressGameKey(code, ascii);
+	debug(1, "Grim Mouse: key: %s", what);
+}
+
+bool HotspotMan::driveEvent(const Common::Event &ev, const Common::Point &cursor) {
+	if (ev.type != Common::EVENT_LBUTTONDOWN && ev.type != Common::EVENT_RBUTTONDOWN)
+		return false;
+	if (!g_grim->getCurrSet())
+		return false;
+	int kind = vehicleKind();
+	if (kind == kNoVehicle)
+		return false;
+	// the handler is the vehicle's: no tap goes anywhere else (the walk taps
+	// would move it by the scripts' own walks), and none in a cut scene, but
+	// for the crane's own: it runs along its track in one
+	if (_cutScene > 0 && !(kind == kCrane && craneMoving() != kNoKey))
+		return true;
+	if (ev.type == Common::EVENT_RBUTTONDOWN || ev.kbd.hasFlags(Common::KBD_ALT)) {
+		driveStop("look");
+		pressKey(Common::KEYCODE_e, 'e', "two fingers: E");
+		return true;
+	}
+	if (kind == kEngine)
+		return engineTap(cursor);
+	Actor *v = vehicle(kind);
+	if (!v)
+		return true;
+	if (kind == kCrane)
+		return craneTap(v, cursor);
+	if (kind == kTunnel)
+		return tunnelTap(v, cursor);
+
+	const DriveScale &sc = kind == kForklift ? kForkliftScale : kWagonScale;
+	// on the vehicle, as it is drawn: U, get out. The forklift: on its seat,
+	// where Manny sits (he is part of its costume while he drives). Seen from
+	// above in the cellar's small elevator its whole box covers the floor round
+	// it and the grating it must drive at, so the rest of it is where to drive
+	// (proof playthrough, 15 Nov 2026).
+	// (jammed in the shaft it can't move but back out, so a tap anywhere on
+	// it is still getting off, and anywhere else backing out)
+	bool onIt;
+	if (kind == kForklift && !luaTrue("de.shaft.stuck")) {
+		// (the seat is behind the forklift's centre, the mast and forks ahead)
+		float yr = v->getYaw().getRadians();
+		Math::Vector3d seat = v->getPos() + Math::Vector3d(sinf(yr) * 0.3f, -cosf(yr) * 0.3f, 0.45f);
+		Math::Vector3d rim = seat + Math::Vector3d(0.f, 0.f, 0.2f);
+		int sx, sy, rx, ry;
+		if (worldToScreen(seat, sx, sy) && worldToScreen(rim, rx, ry)) {
+			int r = MAX(18, (int)sqrtf((float)((rx - sx) * (rx - sx) + (ry - sy) * (ry - sy))));
+			onIt = onActor(v, cursor) && (cursor.x - sx) * (cursor.x - sx) + (cursor.y - sy) * (cursor.y - sy) <= r * r;
+			debug(1, "Grim Mouse: forklift tap %d,%d: seat %d,%d, reach %d: %s", cursor.x, cursor.y, sx, sy, r,
+			      onIt ? "on it" : "not on it");
+		} else
+			onIt = onActor(v, cursor);
+	} else
+		onIt = onActor(v, cursor);
+	if (onIt) {
+		driveStop("tap on the vehicle");
+		pressKey(Common::KEYCODE_u, 'u', "on the vehicle: U");
+		return true;
+	}
+	// the forklift stuck in the shaft only backs out (its handler's Down)
+	if (kind == kForklift && luaTrue("de.shaft.stuck")) {
+		driveStop("stuck in the shaft");
+		pressKey(Common::KEYCODE_DOWN, 0, "forklift stuck in the shaft: Down");
+		return true;
+	}
+	Math::Vector3d target;
+	bool exit;
+	if (!groundPoint(cursor, v->getPos().z(), sc.nearExit, target, exit))
+		return true;
+	// the way there: the game's own route through the sectors the vehicle may
+	// use (as a walk would take it), the point itself if there is none
+	Common::List<Math::Vector3d> path;
+	Math::Vector3d dest;
+	if (v->findPath(target, path, dest))
+		path.push_front(exit ? target : dest);   // a way out: into it, not to the nearest walk sector
+	else {
+		path.clear();
+		path.push_back(target);
+	}
+	float off = angleDiff(v->getYawTo(path.back()).getDegrees() - v->getYaw().getDegrees());
+	bool wasDriving = _driving;
+	_driving = true;
+	_driveKind = kind;
+	// behind it and near: back up (a long way round is driven forwards)
+	Math::Vector3d away = path.front() - v->getPos();
+	away.z() = 0;
+	_driveReverse = fabs(off) > kDriveBehind && away.getMagnitude() < sc.backUp;
+	_driveExit = exit;
+	// already as near the tap as the vehicle can get (the forklift in the
+	// elevator, a box it can barely move in): the tap is where to face, so it
+	// turns on the spot to face it (the 1998 arrows only, no gas), as a player
+	// turned it in a space too small to drive round in
+	_driveTurnOnly = false;
+	if (kind == kForklift && !exit && path.size() == 1) {
+		Math::Vector3d near = path.front() - v->getPos();
+		near.z() = 0;
+		float faceOff = angleDiff(v->getYawTo(target).getDegrees() - v->getYaw().getDegrees());
+		if (near.getMagnitude() < sc.arrive && fabs(faceOff) > kDriveSteer) {
+			_driveTurnOnly = true;
+			_driveReverse = false;
+			path.clear();
+			path.push_back(target);
+		}
+	}
+	_drivePath = path;
+	_driveTarget = path.front();
+	_driveSet = g_grim->getCurrSet()->getName();
+	_driveStart = _driveCheckTime = g_system->getMillis();
+	_driveCheckPos = v->getPos();
+	_driveCheckYaw = v->getYaw().getDegrees();
+	// a new tap mid-drive: the keys held now that the new target doesn't want
+	// are let go by the next update
+	debug(1, "Grim Mouse: %s: drive %s to %.2f,%.2f%s (tap %d,%d, %.0f deg off, %d waypoints)%s", kVehicleNames[kind],
+	      _driveTurnOnly ? "round to face" : _driveReverse ? "back" : "on", _driveTarget.x(), _driveTarget.y(), exit ? ", a way out" : "", cursor.x, cursor.y,
+	      off, _drivePath.size(), wasDriving ? ", re-targeted" : "");
+	driveUpdate();
+	return true;
+}
+
+// The tunnel: Glottis drives the wagon along it (at.drive_forward: y down;
+// at.drive_backward: y up). A tap on the wagon is the remote (I), a tap on the
+// catwalk (at.ledge, what the handler's U climbs onto) is U, anywhere else
+// along the tunnel is where to drive to.
+bool HotspotMan::tunnelTap(Actor *v, const Common::Point &cursor) {
+	// where along the tunnel: the point of Glottis's line (his x, from the
+	// fp sewer to the zw sewer) nearest the tap on screen, so that the tunnel
+	// beyond the wagon, which the wagon hides on screen, can be tapped too
+	Math::Vector3d pos = v->getPos(), target = pos;
+	int bestD = -1;
+	for (float y = -1.f; y <= 13.f; y += 0.1f) {
+		int x, sy;
+		if (!worldToScreen(Math::Vector3d(pos.x(), y, pos.z()), x, sy))
+			continue;
+		int d = (x - cursor.x) * (x - cursor.x) + (sy - cursor.y) * (sy - cursor.y);
+		if (bestD < 0 || d < bestD) {
+			bestD = d;
+			target.y() = y;
+		}
+	}
+	bool ground = bestD >= 0;
+	// on the wagon: the remote, unless the tap is on the tunnel well beyond it
+	if (onActor(v, cursor) && (!ground || fabs(target.y() - pos.y()) < 1.5f)) {
+		driveStop("tap on the wagon");
+		pressKey(Common::KEYCODE_i, 'i', "on the wagon: I (the remote)");
+		return true;
+	}
+	Set *set = g_grim->getCurrSet();
+	int hit = outlineObjectAt(cursor, set->getSetup());
+	if (hit > 0 && hit == (int)luaNumber("at.ledge.hotspot_id")) {
+		driveStop("tap on the catwalk");
+		pressKey(Common::KEYCODE_u, 'u', "on the catwalk: U");
+		return true;
+	}
+	if (!ground)
+		return true;
+	bool wasDriving = _driving;
+	_driving = true;
+	_driveKind = kTunnel;
+	_driveTarget = target;
+	_driveSet = set->getName();
+	_driveStart = _driveCheckTime = g_system->getMillis();
+	_driveCheckPos = v->getPos();
+	debug(1, "Grim Mouse: tunnel ride: to y %.2f from %.2f (tap %d,%d)%s", target.y(), v->getPos().y(), cursor.x, cursor.y,
+	      wasDriving ? ", re-targeted" : "");
+	driveUpdate();
+	return true;
+}
+
+// The crane: its track is the game's own ew.crane_points (0 at the conveyor
+// ... the crusher); Left runs it a point on (ew.crane_actor.move_left), Right a
+// point back, for as long as the key is held. A tap near the track is where to
+// stop; a tap on the crane lowers it (Down) or, lowered, raises it (Up); a tap
+// anywhere else is U, climb out (the game says when it can't, in between).
+bool HotspotMan::craneTap(Actor *v, const Common::Point &cursor) {
+	int n = (int)luaNumber("ew.crane_points.num_points");
+	int best = -1, bestD = kCraneReach * kCraneReach, bestX = 0, bestY = 0;
+	for (int i = 0; i < n; i++) {
+		Common::String p = Common::String::format("ew.crane_points[%d].pos", i);
+		Math::Vector3d w = luaPoint(p + ".x", p + ".y", p + ".z");
+		int x, y;
+		if (!worldToScreen(w, x, y))
+			continue;
+		int d = (x - cursor.x) * (x - cursor.x) + (y - cursor.y) * (y - cursor.y);
+		if (d < bestD) {
+			bestD = d;
+			best = i;
+			bestX = x;
+			bestY = y;
+		}
+	}
+	// PointyClicky Edition (the proof playthrough, 16 Nov 2026): the crane as
+	// drawn (boom and all) covers the track points beside it, so at the crusher
+	// end a tap on the track one or two points on lowered it instead. A tap
+	// right on another point of the track (kCraneOnPoint) is a tap on the track.
+	int cur = (int)luaNumber("ew.crane_actor.cur_point");
+	bool onPoint = best >= 0 && best != cur && bestD <= kCraneOnPoint * kCraneOnPoint;
+	if (onActor(v, cursor) && !onPoint && craneMoving() == kNoKey) {
+		driveStop("tap on the crane");
+		if (luaTrue("ew.crane_down"))
+			pressKey(Common::KEYCODE_UP, 0, "on the crane, lowered: Up");
+		else
+			pressKey(Common::KEYCODE_DOWN, 0, "on the crane: Down");
+		return true;
+	}
+	if (best < 0) {
+		driveStop("tap off the track");
+		pressKey(Common::KEYCODE_u, 'u', "off the track: U");
+		return true;
+	}
+	bool wasDriving = _driving;
+	_driving = true;
+	_driveKind = kCrane;
+	_cranePoint = best;
+	_driveSet = g_grim->getCurrSet()->getName();
+	_driveStart = _driveCheckTime = g_system->getMillis();
+	_craneLast = (int)luaNumber("ew.crane_actor.cur_point");
+	debug(1, "Grim Mouse: crane: to point %d (at %d,%d) from %d (tap %d,%d)%s", best, bestX, bestY, _craneLast, cursor.x, cursor.y,
+	      wasDriving ? ", re-targeted" : "");
+	driveUpdate();
+	return true;
+}
+
+// Which of the crane's runs is under way: kDriveLeft, kDriveRight or kNoKey.
+// (raise_crane_and_move counts as the key it is waiting on.)
+int HotspotMan::craneMoving() {
+	int m = (int)luaNumber("(find_script(ew.crane_actor.move_left) and 1) or (find_script(ew.crane_actor.move_right) and 2) or "
+	                       "(find_script(ew.raise_crane_and_move) and 3) or 0");
+	if (m == 1)
+		return kDriveLeft;
+	if (m == 2)
+		return kDriveRight;
+	if (m == 3)
+		return _driveHeld[kDriveLeft] ? kDriveLeft : _driveHeld[kDriveRight] ? kDriveRight : kNoKey;
+	return kNoKey;
+}
+
+// The ship's engine keeps its levers (moments.md line 3): the game's own
+// levers, dial and Manny as drawn. A tap on the left lever pushes it (the
+// handler's Right: drive_ship "starboard", mn_levers_left_up), on the right
+// lever its Left ("port", mn_levers_right_up); on the dials above them Up
+// (both levers ahead), on the console below them Down (both back); anywhere
+// else lets go of the controls (U). Each tap is one press.
+bool HotspotMan::engineTap(const Common::Point &cursor) {
+	int lx, ly, rx, ry;
+	if (!worldToScreen(luaPoint("ei.left_control.obj_x", "ei.left_control.obj_y", "ei.left_control.obj_z"), lx, ly) ||
+	    !worldToScreen(luaPoint("ei.right_control.obj_x", "ei.right_control.obj_y", "ei.right_control.obj_z"), rx, ry))
+		return true;
+	int mid = (lx + rx) / 2, band = (ly + ry) / 2, half = ABS(rx - lx) / 2 + 40;
+	debug(1, "Grim Mouse: ship's engine: levers at %d,%d and %d,%d, tap %d,%d", lx, ly, rx, ry, cursor.x, cursor.y);
+	if (ABS(cursor.x - mid) > half || cursor.y < band - 110 || cursor.y > band + 90)
+		pressKey(Common::KEYCODE_u, 'u', "away from the controls: U");
+	else if (cursor.y < band - 25)
+		pressKey(Common::KEYCODE_UP, 0, "the dials: Up (ahead)");
+	else if (cursor.y > band + 25)
+		pressKey(Common::KEYCODE_DOWN, 0, "the console below the levers: Down (reverse)");
+	else if (cursor.x < mid)
+		pressKey(Common::KEYCODE_RIGHT, 0, "the left lever: Right (starboard)");
+	else
+		pressKey(Common::KEYCODE_LEFT, 0, "the right lever: Left (port)");
+	return true;
+}
+
+void HotspotMan::driveUpdate() {
+	// every linked actor's box measured every frame, so that a first tap on a
+	// character or a vehicle finds it (a pointer that never hovered there too)
+	for (uint i = 1; i < _hotobject.size(); i++)
+		if (_hotobject[i]._actor)
+			if (Actor *a = Actor::getPool().getObject(_hotobject[i]._actor))
+				a->_screenBoxWanted = true;
+	if (!_driving)
+		return;
+	Set *set = g_grim->getCurrSet();
+	if (!set || set->getName() != _driveSet)
+		return driveStop("the scene changed");
+	if (g_grim->getMode() != GrimEngine::NormalMode)
+		return driveStop("not in play");
+	if (vehicleKind() != _driveKind)
+		return driveStop("out of the vehicle");
+	if (_driveKind == kCrane)
+		return craneUpdate();
+	if (_cutScene > 0)
+		return driveStop("cut scene");
+	Actor *v = vehicle(_driveKind);
+	if (!v)
+		return driveStop("no vehicle");
+	if (_driveKind == kTunnel)
+		return tunnelUpdate(v);
+	const DriveScale &sc = _driveKind == kForklift ? kForkliftScale : kWagonScale;
+	uint32 now = g_system->getMillis();
+	if (now - _driveStart > sc.timeout)
+		return driveStop("took too long");
+
+	Math::Vector3d pos = v->getPos();
+	float yaw = v->getYaw().getDegrees();
+	// how far the vehicle must turn to the next waypoint: its nose to it, or
+	// going back, its tail; a waypoint reached (or passed) gives the next
+	float off = 0.f, dist = 0.f;
+	for (;;) {
+		Math::Vector3d d = _drivePath.back() - pos;
+		d.z() = 0;
+		dist = d.getMagnitude();
+		off = angleDiff(v->getYawTo(_drivePath.back()).getDegrees() + (_driveReverse ? 180.f : 0.f) - yaw);
+		if (_drivePath.size() == 1 || !(dist < sc.waypoint || (dist < 2 * sc.waypoint && fabs(off) > 90.f)))
+			break;
+		_drivePath.pop_back();
+	}
+	debug(3, "Grim Mouse: drive t=%u at %.2f,%.2f yaw %.0f, %.0f deg off, %.2f to go, %d waypoints, keys %d%d%d%d",
+	      now - _driveStart, pos.x(), pos.y(), yaw, off, dist, _drivePath.size(),
+	      _driveHeld[0], _driveHeld[1], _driveHeld[2], _driveHeld[3]);
+	if (_driveTurnOnly) {
+		// turning on the spot to face the tap: the arrow that turns it, no gas
+		driveKey(kDriveUp, false);
+		driveKey(kDriveDown, false);
+		if (fabs(off) <= kDriveSteer)
+			return driveStop("facing it");
+		if (now - _driveCheckTime >= kDriveStall) {
+			if (fabs(angleDiff(yaw - _driveCheckYaw)) < kDriveStallTurn)
+				return driveStop("can't turn here");
+			_driveCheckTime = now;
+			_driveCheckYaw = yaw;
+		}
+		bool wantLeft = off > 0;
+		driveKey(wantLeft ? kDriveRight : kDriveLeft, false);
+		driveKey(wantLeft ? kDriveLeft : kDriveRight, true);
+		return;
+	}
+	// (on a way out, "there" is well inside it: by then the game has taken the
+	// scene away, or it had something to say instead: Glottis won't go yet)
+	if (_drivePath.size() == 1 && dist < (_driveExit ? sc.arrive / 3 : sc.arrive))
+		return driveStop("there");
+	if (_drivePath.size() == 1 && !_driveExit && dist < sc.passed && fabs(off) > 100.f)
+		return driveStop("went past it");
+
+	if (now - _driveCheckTime >= kDriveStall) {
+		Math::Vector3d moved = pos - _driveCheckPos;
+		moved.z() = 0;
+		if (moved.getMagnitude() < sc.stallMove && fabs(angleDiff(yaw - _driveCheckYaw)) < kDriveStallTurn)
+			return driveStop(_drivePath.size() == 1 && dist < 2 * sc.passed ? "as near as it gets" : "blocked");
+		_driveCheckTime = now;
+		_driveCheckPos = pos;
+		_driveCheckYaw = yaw;
+	}
+
+	// The throttle: Up (or Down going back) while roughly facing the point; let
+	// go to turn tighter. The Bone Wagon starts its gas script on the key going
+	// down and runs it while the key is held; once that script has rolled to a
+	// stop, holding on does nothing, so the key goes up and down again, as a
+	// player's would. (The forklift's forward runs for as long as it's held.)
+	int gas = _driveReverse ? kDriveDown : kDriveUp;
+	driveKey(_driveReverse ? kDriveUp : kDriveDown, false);
+	bool wantGas = fabs(off) < kDriveThrottle;
+	if (wantGas && _driveHeld[gas]) {
+		const char *running = _driveKind == kWagon ?
+			(_driveReverse ? "find_script(bonewagon.reverse)" : "find_script(bonewagon.gas)") :
+			(_driveReverse ? "find_script(de.forklift_actor.backward)" : "find_script(de.forklift_actor.forward)");
+		if (!luaTrue(running))
+			driveKey(gas, false);
+	}
+	driveKey(gas, wantGas);
+
+	// The steering: which arrow turns the vehicle the way it must go. The
+	// forklift: Left always turns it left (TurnActor 1). The Bone Wagon, by the
+	// rule of the game's own bonewagon.monitor_turns: rolling forward Left
+	// turns it left, rolling back Left turns it right, standing still Left
+	// turns it left on the spot.
+	if (fabs(off) <= kDriveSteer) {
+		driveKey(kDriveLeft, false);
+		driveKey(kDriveRight, false);
+	} else {
+		bool leftTurnsLeft = true;
+		if (_driveKind == kWagon) {
+			int st = (int)luaNumber(
+				"(((bonewagon.turn_rate > 1) and 1 or 0) + ((bonewagon.walk_rate > 0) and 2 or 0))");
+			bool rolling = (st & 1) != 0, forward = (st & 2) != 0 || _driveHeld[kDriveUp];
+			leftTurnsLeft = !rolling || forward;
+		}
+		bool wantLeft = (off > 0) == leftTurnsLeft;   // a positive yaw is a turn to the left
+		driveKey(wantLeft ? kDriveRight : kDriveLeft, false);
+		driveKey(wantLeft ? kDriveLeft : kDriveRight, true);
+	}
+}
+
+void HotspotMan::tunnelUpdate(Actor *v) {
+	uint32 now = g_system->getMillis();
+	if (now - _driveStart > kTunnelTimeout)
+		return driveStop("took too long");
+	float dy = _driveTarget.y() - v->getPos().y();
+	if (fabs(dy) < kTunnelArrive)
+		return driveStop("there");
+	if (now - _driveCheckTime >= kDriveStall) {
+		// at.drive_forward stops short of the albinizod by itself
+		if (fabs(v->getPos().y() - _driveCheckPos.y()) < 0.02f)
+			return driveStop("blocked");
+		_driveCheckTime = now;
+		_driveCheckPos = v->getPos();
+	}
+	int want = dy < 0 ? kDriveUp : kDriveDown;
+	driveKey(want == kDriveUp ? kDriveDown : kDriveUp, false);
+	driveKey(want, true);
+}
+
+void HotspotMan::craneUpdate() {
+	uint32 now = g_system->getMillis();
+	if (now - _driveStart > kCraneTimeout)
+		return driveStop("took too long");
+	int cur = (int)luaNumber("ew.crane_actor.cur_point");
+	int moving = craneMoving();
+	if (cur == _cranePoint && moving == kNoKey)
+		return driveStop("there");
+	if (cur != _craneLast) {
+		_craneLast = cur;
+		_driveCheckTime = now;
+	} else if (now - _driveCheckTime > kCraneStall)
+		return driveStop("blocked");
+	int want = _cranePoint > cur ? kDriveLeft : _cranePoint < cur ? kDriveRight : kNoKey;
+	if (moving != kNoKey) {
+		// running: on the way there, it lets go a point early, so that the run
+		// in hand ends on the point (move_left checks the key between points)
+		bool last = (moving == kDriveLeft && cur >= _cranePoint - 1) || (moving == kDriveRight && cur <= _cranePoint + 1);
+		if (moving != want || last) {
+			driveKey(kDriveLeft, false);
+			driveKey(kDriveRight, false);
+		}
+		return;
+	}
+	if (want == kNoKey)
+		return;
+	// standing: press the way there (the handler takes a key only out of a cut
+	// scene); a key held this long with nothing running wasn't taken: again
+	if (_driveHeld[want] && now - _drivePressTime > 300)
+		driveKey(want, false);
+	else if (_cutScene == 0) {
+		driveKey(want == kDriveLeft ? kDriveRight : kDriveLeft, false);
+		driveKey(want, true);
+	}
+}
+
+// ---------------------------------------------------------------------------
+// PointyClicky Edition: the other moments the game takes the controls
+// (docs/moments.md, lines 6-24). As with the vehicles, nothing here moves Manny
+// or works a machine: a tap becomes the original's keys for the game's own
+// handler, and the scripts do the rest.
+//
+//   the wheelbarrow (wheelbarrow_button_handler), the anchor room crawl
+//   (drift_button_handler, also how Manny comes back from the Lamancha), the
+//   conveyor chain (cy.drift_button_handler) and the ladders (the normal
+//   handler while is_climbing): a tap along Manny's way is where to go, Up or
+//   Down held until he's there;
+//   Copal's computer (co.computer), the ticket printer (tpButtonHandler) and
+//   the elevator's floors (br2): the arrows pressed one at a time until the
+//   reply, the dial or the floor tapped is the selected one, then U (Enter);
+//   the roulette panel, the vault's wheel, the broadaxe, the rope on the
+//   ledge, the meadow, the three one-key scenes and Chepito's hand-over: a
+//   tap on the thing is its key;
+//   the fire extinguisher: held, U is held (a quick tap is a tap).
+
+static const uint32 kMomentStall = 1500;      // along a line: no progress in this long, blocked
+static const uint32 kMomentTimeout = 30000;
+static const float kAxeThere = 0.06f;        // the broadaxe: this near the tap is there (the drop is 0.15-0.43 from the tile)
+static const int kAxeEdge = 10;              // ... a tap this near the screen's edge is past it
+static const float kAxeEdgeMore = 0.6f;      // ... by this much
+static const uint32 kQueueGap = 250;          // a queued press no sooner than this after the last
+static const uint32 kQueueHold = 100;         // ... and held this long
+static const uint32 kQueueTimeout = 8000;
+static const uint32 kFingerTap = 250;         // the extinguisher: a press let go sooner is a tap
+static const uint32 kFingerMinHold = 120;     // a key held for a finger is held at least this long
+
+static const char *const kMomentNames[] = { "", "wheelbarrow", "crawl", "chain", "computer", "roulette panel",
+	"ticket printer", "vault wheel", "broadaxe", "extinguisher", "extinguisher (spraying)", "rope", "meadow",
+	"one key", "hand-over", "elevator", "ladder" };
+
+// Which of the game's handlers is installed (kMNone if none of these).
+int HotspotMan::momentKind() {
+	return (int)luaNumber(
+		"((wheelbarrow_button_handler ~= nil and system.buttonHandler == wheelbarrow_button_handler) and 1) or "
+		"((drift_button_handler ~= nil and system.buttonHandler == drift_button_handler) and 2) or "
+		"((cy ~= nil and cy.drift_button_handler ~= nil and system.buttonHandler == cy.drift_button_handler) and 3) or "
+		"((co ~= nil and co.computer ~= nil and system.buttonHandler == co.computer) and 4) or "
+		"((roulettePanelButtonHandler ~= nil and system.buttonHandler == roulettePanelButtonHandler) and 5) or "
+		"((tpButtonHandler ~= nil and system.buttonHandler == tpButtonHandler) and 6) or "
+		"((vd ~= nil and vd.buttonHandler ~= nil and system.buttonHandler == vd.buttonHandler) and 7) or "
+		"((axeButtonHandler ~= nil and system.buttonHandler == axeButtonHandler) and 8) or "
+		"((fireExtinguisherHandler ~= nil and system.buttonHandler == fireExtinguisherHandler) and 10) or "
+		"((system.buttonHandler == SampleButtonHandler and bd ~= nil and system.currentSet == bd and manny.is_holding ~= nil and "
+		"manny.is_holding == bd.extinguisher) and 9) or "
+		"((ledge_rope_button_handler ~= nil and system.buttonHandler == ledge_rope_button_handler) and 11) or "
+		"((dead_button_handler ~= nil and system.buttonHandler == dead_button_handler) and 12) or "
+		"((shiver_button_handler ~= nil and system.buttonHandler == shiver_button_handler) and 13) or "
+		"((camera_button_handler ~= nil and system.buttonHandler == camera_button_handler) and 13) or "
+		"((pfButtonHandler ~= nil and system.buttonHandler == pfButtonHandler) and 13) or "
+		"((suButtonHandler ~= nil and system.buttonHandler == suButtonHandler) and 14) or "
+		"((br2 ~= nil and system.buttonHandler == br2) and 15) or "
+		"((system.buttonHandler == SampleButtonHandler and system.currentActor ~= nil and system.currentActor.is_climbing) and 16) or 0");
+}
+
+// Manny as drawn: from his feet to the top of his head, a quarter of that
+// either side (as the tap on Manny that opens the coat).
+static bool onManny(HotspotMan *hm, const Common::Point &p) {
+	Common::Point feet = hm->mannyPos2D(0.f), head = hm->mannyPos2D(0.6f);
+	if (!feet.x && !feet.y)
+		return false;
+	int top = MIN(feet.y, head.y) - 8, bottom = MAX(feet.y, head.y) + 4, cx = (feet.x + head.x) / 2;
+	return p.y >= top && p.y <= bottom && ABS(p.x - cx) <= MAX(20, (bottom - top) / 4);
+}
+
+// Which way an actor faces (Grim's own forward vector, Actor::walkForward).
+static Math::Vector3d facing(Actor *a) {
+	float y = a->getYaw().getRadians();
+	return Math::Vector3d(-sin(y), cos(y), 0.f);
+}
+
+void HotspotMan::momentHold(Common::KeyCode code, bool down) {
+	int i = 0;
+	while (i < _momNumHeld && _momHeld[i] != code)
+		i++;
+	if (down == (i < _momNumHeld))
+		return;
+	if (down) {
+		if (_momNumHeld >= 4)
+			return;
+		_momHeld[_momNumHeld++] = code;
+	} else
+		_momHeld[i] = _momHeld[--_momNumHeld];
+	g_grim->holdGameKey(code, down);
+}
+
+void HotspotMan::momentStop(const char *why) {
+	while (_momNumHeld > 0)
+		momentHold(_momHeld[0], false);
+	if (_momKind != kMNone)
+		debug(1, "Grim Mouse: %s: ends (%s)", kMomentNames[_momKind], why);
+	_momKind = kMNone;
+}
+
+// A tap along Manny's way: the point of his line (through where he is, along
+// the moment's axis) nearest the tap on screen. Up (or Down) is held until he
+// gets there.
+bool HotspotMan::momentLine(int kind, const Common::Point &cursor) {
+	Actor *manny = getManny();
+	if (!manny)
+		return true;
+	Math::Vector3d axis, ref;   // ref: the part of Manny the tap is measured against
+	float range = 8.f;
+	if (kind == kMWheelbarrow || kind == kMCrawl)
+		axis = facing(manny);
+	else if (kind == kMChain) {
+		// the chain runs from the game's own bottom drift point to its top one
+		axis = luaPoint("cy.chain_drift_top.pos.x", "cy.chain_drift_top.pos.y", "cy.chain_drift_top.pos.z") -
+		       luaPoint("cy.chain_drift_bottom.pos.x", "cy.chain_drift_bottom.pos.y", "cy.chain_drift_bottom.pos.z");
+		range = 3.f;
+	} else {
+		axis = Math::Vector3d(0, 0, 1);
+		ref = Math::Vector3d(0, 0, 0.25f);   // his middle on the ladder, not his feet
+		range = 15.f;
+	}
+	if (axis.getMagnitude() < 1e-4f)
+		return true;
+	axis.normalize();
+	Math::Vector3d at = manny->getPos() + ref;
+	float best = 0.f;
+	int bestD = -1;
+	for (float sv = -range; sv <= range; sv += 0.025f) {
+		int x, y;
+		if (!worldToScreen(at + axis * sv, x, y))
+			continue;
+		int d = (x - cursor.x) * (x - cursor.x) + (y - cursor.y) * (y - cursor.y);
+		if (bestD < 0 || d < bestD) {
+			bestD = d;
+			best = sv;
+		}
+	}
+	if (bestD < 0)
+		return true;
+	momentStop("re-targeted");
+	_momKind = kind;
+	_momAxis = axis;
+	_momOrigin = manny->getPos();
+	_momTarget = best;
+	_momCheckS = 0.f;
+	_momArrive = kind == kMLadder ? 0.15f : kind == kMChain ? 0.05f : 0.1f;
+	_momFwd = Common::KEYCODE_UP;
+	_momBack = Common::KEYCODE_DOWN;
+	_momStart = _momCheckTime = g_system->getMillis();
+	int fx = 0, fy = 0;
+	worldToScreen(manny->getPos(), fx, fy);
+	debug(1, "Grim Mouse: %s: to %.2f along the way (tap %d,%d; Manny's feet %d,%d)", kMomentNames[kind], best, cursor.x, cursor.y, fx, fy);
+	lineUpdate();
+	return true;
+}
+
+void HotspotMan::lineUpdate() {
+	Actor *manny = getManny();
+	if (!manny)
+		return momentStop("no Manny");
+	uint32 now = g_system->getMillis();
+	if (now - _momStart > kMomentTimeout)
+		return momentStop("took too long");
+	float s = (manny->getPos() - _momOrigin).dotProduct(_momAxis);
+	float togo = _momTarget - s;
+	if (fabs(togo) < _momArrive) {
+		int fx = 0, fy = 0;
+		worldToScreen(manny->getPos(), fx, fy);
+		debug(1, "Grim Mouse: %s: Manny's feet %d,%d", kMomentNames[_momKind], fx, fy);
+		return momentStop("there");
+	}
+	if (now - _momCheckTime >= kMomentStall) {
+		if (fabs(s - _momCheckS) < 0.01f)
+			return momentStop("as far as it goes");
+		_momCheckTime = now;
+		_momCheckS = s;
+	}
+	Common::KeyCode want = togo > 0 ? _momFwd : _momBack;
+	momentHold(want == _momFwd ? _momBack : _momFwd, false);
+	momentHold(want, true);
+}
+
+// The broadaxe: Manny drags it backwards, so a tap on the floor is turned to
+// (his back to it: Left or Right held), then backed to (Down held).
+void HotspotMan::axeUpdate() {
+	Actor *manny = getManny();
+	if (!manny)
+		return momentStop("no Manny");
+	uint32 now = g_system->getMillis();
+	if (now - _momStart > kMomentTimeout)
+		return momentStop("took too long");
+	Math::Vector3d d = _momPoint - manny->getPos();
+	d.z() = 0;
+	float dist = d.getMagnitude();
+	float off = angleDiff(manny->getYawTo(_momPoint).getDegrees() + 180.f - manny->getYaw().getDegrees());
+	// (an edge tap: on past the screen's edge, until the game changes the camera)
+	if (_momSetup >= 0 && g_grim->getCurrSet() && g_grim->getCurrSet()->getSetup() != _momSetup)
+		return momentStop("the camera changed");
+	if (dist < kAxeThere || (_momNumHeld && _momHeld[0] == Common::KEYCODE_DOWN && fabs(off) > 100.f))
+		return momentStop("there");
+	bool backing = false;
+	for (int i = 0; i < _momNumHeld; i++)
+		backing |= _momHeld[i] == Common::KEYCODE_DOWN;
+	if (fabs(off) > (backing ? 35.f : 12.f)) {
+		// vo.turn_left adds to the yaw (a positive turn), vo.turn_right takes away
+		momentHold(Common::KEYCODE_DOWN, false);
+		momentHold(off > 0 ? Common::KEYCODE_RIGHT : Common::KEYCODE_LEFT, false);
+		momentHold(off > 0 ? Common::KEYCODE_LEFT : Common::KEYCODE_RIGHT, true);
+		_momCheckTime = now;
+		return;
+	}
+	momentHold(Common::KEYCODE_LEFT, false);
+	momentHold(Common::KEYCODE_RIGHT, false);
+	if (now - _momCheckTime >= kMomentStall) {
+		Math::Vector3d moved = manny->getPos() - _momOrigin;
+		moved.z() = 0;
+		if (backing && moved.getMagnitude() < 0.02f)
+			return momentStop("blocked");
+		_momCheckTime = now;
+		_momOrigin = manny->getPos();
+	}
+	momentHold(Common::KEYCODE_DOWN, true);
+}
+
+// One press at a time, when the game is ready for the next, until the goal is
+// selected; then the press that acts on it (_momThen: a key, 0 for none).
+void HotspotMan::queueUpdate() {
+	uint32 now = g_system->getMillis();
+	if (now - _momStart > kQueueTimeout)
+		return momentStop("took too long");
+	// each press is held a moment (the game's scripts loop while the key is
+	// down, so a key let go in the same frame does nothing), then let go
+	if (_momNumHeld > 0) {
+		if (now - _momLastPress >= kQueueHold)
+			momentHold(_momHeld[0], false);
+		return;
+	}
+	if (now - _momLastPress < kQueueGap)
+		return;
+	int cur;
+	Common::KeyCode key = Common::KEYCODE_INVALID;
+	if (_momKind == kMComputer) {
+		if (!luaTrue("not find_script(co.computer.wait_for_joystick_release) and cutSceneLevel <= 0"))
+			return;
+		cur = (int)luaNumber("co.computer.selection");
+		if (cur != _momGoal)
+			key = cur < _momGoal ? Common::KEYCODE_DOWN : Common::KEYCODE_UP;
+	} else if (_momKind == kMPrinter) {
+		if (!luaTrue("not find_script(tp.move_left) and not find_script(tp.move_right) and not find_script(tp.push_up) and "
+		             "not find_script(tp.push_down) and cutSceneLevel <= 0"))
+			return;
+		// the hands go round the dials as tp.move_left takes them: race, day, week, print
+		static const char *const order[] = { "tp.RACE", "tp.DAY", "tp.WEEK", "tp.PRINT" };
+		cur = (int)luaNumber("tp.current_button");
+		int ci = -1, gi = -1;
+		for (int i = 0; i < 4; i++) {
+			int v = (int)luaNumber(order[i]);
+			if (v == cur)
+				ci = i;
+			if (v == _momGoal)
+				gi = i;
+		}
+		if (ci < 0 || gi < 0)
+			return momentStop("no such dial");
+		if (ci != gi)
+			key = ((gi - ci + 4) % 4) <= 2 ? Common::KEYCODE_LEFT : Common::KEYCODE_RIGHT;
+	} else {   // the elevator
+		if (!luaTrue("not find_script(br2.line_up) and not find_script(br2.line_down) and not find_script(br2.choose_line)"))
+			return;
+		cur = (int)luaNumber("br2.current_line");
+		if (cur != _momGoal)
+			key = cur < _momGoal ? Common::KEYCODE_DOWN : Common::KEYCODE_UP;
+	}
+	if (key == Common::KEYCODE_INVALID) {
+		int then = _momThen;
+		const char *what = kMomentNames[_momKind];
+		_momKind = kMNone;
+		if (then) {
+			g_grim->pressGameKey((Common::KeyCode)then, then < 128 ? then : 0);
+			debug(1, "Grim Mouse: %s: there, key %d", what, then);
+		} else
+			debug(1, "Grim Mouse: %s: there", what);
+		return;
+	}
+	momentHold(key, true);
+	_momLastPress = now;
+}
+
+bool HotspotMan::momentEvent(const Common::Event &ev, const Common::Point &cursor) {
+	if (_replaying || !g_grim->getCurrSet())
+		return false;
+	bool up = ev.type == Common::EVENT_LBUTTONUP || ev.type == Common::EVENT_RBUTTONUP;
+	if (up) {
+		// the finger lifts: a held-back press was a tap after all, or a held key goes up
+		if (_fingerPending) {
+			_fingerPending = false;
+			_replaying = true;
+			Common::Event e = _fingerEvent;
+			g_grim->replayMouseEvent(e);
+			_replaying = false;
+			debug(1, "Grim Mouse: extinguisher: a tap");
+			return true;
+		}
+		if (_fingerDown) {
+			_fingerRelease = true;
+			momentUpdate();
+			return true;
+		}
+		return false;
+	}
+	if (ev.type != Common::EVENT_LBUTTONDOWN && ev.type != Common::EVENT_RBUTTONDOWN)
+		return false;
+	int kind = momentKind();
+	if (kind == kMNone)
+		return false;
+	bool look = ev.type == Common::EVENT_RBUTTONDOWN || ev.kbd.hasFlags(Common::KBD_ALT);
+	if (kind == kMExtinguisher) {
+		// ready to spray: two fingers, a tap on Manny (put it away) and quick taps
+		// are the usual pointer; a press held is U held
+		if (look || onManny(this, cursor) || _cutScene > 0)
+			return false;
+		_fingerPending = true;
+		_fingerEvent = ev;
+		_fingerTime = g_system->getMillis();
+		return true;
+	}
+	// the game's handler has the controls: no tap goes anywhere else
+	if (_cutScene > 0 && kind != kMAnyKey)
+		return true;
+	if (look) {
+		momentStop("look");
+		pressKey(Common::KEYCODE_e, 'e', "two fingers: E");
+		return true;
+	}
+	Set *set = g_grim->getCurrSet();
+	int setup = set->getSetup();
+	Common::String region;
+	Common::Array<MouseHotspot> &hotspots = hotspotsOf(activeSet());
+	for (uint i = 0; i < hotspots.size(); i++)
+		if (hotspots[i]._setup == setup && hotspots[i]._type >= 10 && hotspots[i]._region.contains(cursor))
+			region = hotspots[i]._id;
+
+	switch (kind) {
+	case kMWheelbarrow:
+		if (onManny(this, cursor) || onActor(luaActor("tr.barrow"), cursor)) {
+			momentStop("let go");
+			pressKey(Common::KEYCODE_u, 'u', "wheelbarrow: U (let go)");
+			return true;
+		}
+		return momentLine(kind, cursor);
+	case kMCrawl:
+	case kMChain:
+	case kMLadder:
+		return momentLine(kind, cursor);
+	case kMComputer: {
+		// the six replies on screen (co.computer.text: from y 150, 40 apart)
+		int row = (cursor.y - 140) / 40;
+		if (cursor.y < 140 || row > 5 || cursor.x < 160 || cursor.x > 500)
+			return true;
+		int top = (int)luaNumber("co.computer.top_line");
+		bool more = (int)luaNumber("(co.computer.choices[co.computer.top_line + 6] ~= nil) and 1 or 0") != 0;
+		momentStop("re-targeted");
+		_momKind = kind;
+		_momStart = g_system->getMillis();
+		_momLastPress = 0;
+		if (row == 5 && more) {
+			_momGoal = top + 6;   // the next reply: the list scrolls
+			_momThen = 0;
+		} else if (row == 0 && top > 0) {
+			_momGoal = top - 1;   // the one before: the list scrolls back
+			_momThen = 0;
+		} else {
+			_momGoal = top + row;
+			_momThen = Common::KEYCODE_u;
+		}
+		debug(1, "Grim Mouse: computer: reply %d (row %d, top %d)%s", _momGoal + 1, row, top, _momThen ? ", then U" : "");
+		queueUpdate();
+		return true;
+	}
+	case kMRoulette:
+		if (region == "sxmagnet")
+			pressKey(Common::KEYCODE_u, 'u', "roulette panel: the switch, U");
+		return true;
+	case kMPrinter: {
+		const char *dial = nullptr;
+		int then = 0;
+		if (region == "sxlup" || region == "sxldn")
+			dial = "tp.WEEK";
+		else if (region == "sxmup" || region == "sxmdn")
+			dial = "tp.DAY";
+		else if (region == "sxrup" || region == "sxrdn")
+			dial = "tp.RACE";
+		else if (region == "sxprint")
+			dial = "tp.PRINT";
+		if (!dial)
+			return true;
+		then = region.hasSuffix("up") ? Common::KEYCODE_UP : Common::KEYCODE_DOWN;
+		momentStop("re-targeted");
+		_momKind = kind;
+		_momGoal = (int)luaNumber(dial);
+		_momThen = then;
+		_momStart = g_system->getMillis();
+		_momLastPress = 0;
+		debug(1, "Grim Mouse: ticket printer: %s, then %s", dial, then == Common::KEYCODE_UP ? "Up" : "Down");
+		queueUpdate();
+		return true;
+	}
+	case kMVault:
+		// the wheel's right half turns it clockwise (Right), its left half back (Left),
+		// for as long as the finger is down
+		// (the close-up has the halves outlined; on the wider view, the wheel's
+		// own point, vd.wheel, is its middle)
+		if (region != "sxleft" && region != "sxright") {
+			int wx, wy;
+			if (!worldToScreen(luaPoint("vd.wheel.obj_x", "vd.wheel.obj_y", "vd.wheel.obj_z"), wx, wy) ||
+			    ABS(cursor.x - wx) > 120 || ABS(cursor.y - wy) > 120)
+				return true;
+			region = cursor.x >= wx ? "sxright" : "sxleft";
+		}
+		_fingerKey = region == "sxright" ? Common::KEYCODE_RIGHT : Common::KEYCODE_LEFT;
+		_fingerDown = true;
+		_fingerRelease = false;
+		_fingerTime = g_system->getMillis();
+		g_grim->holdGameKey(_fingerKey, true);
+		debug(1, "Grim Mouse: vault wheel: %s held", region == "sxright" ? "Right" : "Left");
+		return true;
+	case kMAxe: {
+		if (onManny(this, cursor)) {
+			momentStop("drop");
+			pressKey(Common::KEYCODE_u, 'u', "broadaxe: U (drop it)");
+			return true;
+		}
+		Actor *manny = getManny();
+		Math::Vector3d target;
+		bool exit;
+		if (!manny || !groundPoint(cursor, manny->getPos().z(), 0.f, target, exit))
+			return true;
+		momentStop("re-targeted");
+		// PointyClicky Edition (the proof playthrough, 16 Nov 2026): a tap at the
+		// screen's edge is a point past it. In the vault's armour corner (vo,
+		// setup 2) the floor's last visible row is the camera's own boundary, so
+		// no tap could back Manny out of that view, and the drag to the secret
+		// door was a dead end. There the target goes on along the same line
+		// (kAxeEdgeMore) and the drag ends when the game changes the camera.
+		_momSetup = -1;
+		if (cursor.y >= kGameH - kAxeEdge || cursor.x < kAxeEdge || cursor.x >= kGameW - kAxeEdge) {
+			Math::Vector3d along = target - manny->getPos();
+			along.z() = 0;
+			if (along.getMagnitude() > 1e-3f) {
+				along.normalize();
+				target += along * kAxeEdgeMore;
+				_momSetup = g_grim->getCurrSet()->getSetup();
+			}
+		}
+		_momKind = kind;
+		_momPoint = target;
+		_momOrigin = manny->getPos();
+		_momStart = _momCheckTime = g_system->getMillis();
+		debug(1, "Grim Mouse: broadaxe: back to %.2f,%.2f (tap %d,%d)%s", target.x(), target.y(), cursor.x, cursor.y,
+		      _momSetup >= 0 ? ", past the edge" : "");
+		axeUpdate();
+		return true;
+	}
+	case kMSpraying:
+		// spraying with no finger on it (the game started it from a tap): this stops it
+		if (!_fingerDown) {
+			g_grim->holdGameKey(Common::KEYCODE_u, true);
+			g_grim->holdGameKey(Common::KEYCODE_u, false);
+		}
+		return true;
+	case kMRope:
+		if (onManny(this, cursor))
+			pressKey(Common::KEYCODE_i, 'i', "rope: on Manny, I");
+		else
+			pressKey(Common::KEYCODE_u, 'u', "rope: U (throw)");
+		return true;
+	case kMMeadow: {
+		int hit = outlineObjectAt(cursor, setup);
+		if (hit > 0 && hit == (int)luaNumber("mf.wound.hotspot_id"))
+			pressKey(Common::KEYCODE_u, 'u', "meadow: the wound, U");
+		else if (onActor(getManny(), cursor))   // (as drawn: he lies in the flowers)
+			pressKey(Common::KEYCODE_i, 'i', "meadow: on Manny, I");
+		else
+			pressKey(Common::KEYCODE_UP, 0, "meadow: Up (flail)");
+		return true;
+	}
+	case kMAnyKey:
+		pressKey(Common::KEYCODE_u, 'u', "one key: U");
+		return true;
+	case kMHandOver:
+		if (onActor(luaActor("glottis"), cursor))
+			pressKey(Common::KEYCODE_RIGHT, 0, "hand-over: on Glottis, Right");
+		return true;
+	case kMElevator: {
+		// the floors (Grim Mouse's layout of the list: four rows from y 366, 22
+		// apart), and its arrows above and below them
+		int top = (int)luaNumber("br2.top_line"), n = (int)luaNumber("br2.num_choices");
+		int goal = -1, then = Common::KEYCODE_RETURN;
+		if (region == "dxup")
+			goal = MAX(1, (int)luaNumber("br2.current_line") - 1), then = 0;
+		else if (region == "dxdown")
+			goal = MIN(n, (int)luaNumber("br2.current_line") + 1), then = 0;
+		else if (cursor.y >= 366 && cursor.y < 366 + 4 * 22 && cursor.x < 420) {
+			int row = (cursor.y - 366) / 22;
+			goal = top + row;
+			if (row == 3 && goal < n)
+				then = 0;   // "...": more follow, so this scrolls on to it
+			if (goal > n)
+				return true;
+		}
+		if (goal < 1)
+			return true;
+		momentStop("re-targeted");
+		_momKind = kind;
+		_momGoal = goal;
+		_momThen = then;
+		_momStart = g_system->getMillis();
+		_momLastPress = 0;
+		debug(1, "Grim Mouse: elevator: floor line %d of %d (top %d)%s", goal, n, top, then ? ", then Enter" : "");
+		queueUpdate();
+		return true;
+	}
+	default:
+		return true;
+	}
+}
+
+void HotspotMan::momentUpdate() {
+	uint32 now = g_system->getMillis();
+	if (Actor *manny = getManny())
+		manny->_screenBoxWanted = true;   // (where he's drawn, for the moments' taps on him)
+	// a press held back on the extinguisher: held long enough, it's a spray (U held)
+	if (_fingerPending && now - _fingerTime >= kFingerTap) {
+		_fingerPending = false;
+		if (momentKind() == kMExtinguisher && _cutScene == 0) {
+			_fingerKey = Common::KEYCODE_u;
+			_fingerDown = true;
+			_fingerRelease = false;
+			_fingerTime = now;
+			g_grim->holdGameKey(_fingerKey, true);
+			debug(1, "Grim Mouse: extinguisher: U held");
+		}
+	}
+	if (_fingerDown) {
+		// let go: no sooner than the game can see it (its scripts read the key a
+		// frame later), and for the extinguisher not before its own handler is
+		// in, which is the one that hears U go up
+		bool ready = now - _fingerTime >= kFingerMinHold;
+		if (ready && _fingerKey == Common::KEYCODE_u && momentKind() != kMSpraying && now - _fingerTime < 3000)
+			ready = false;
+		if (_fingerRelease && ready) {
+			g_grim->holdGameKey(_fingerKey, false);
+			_fingerDown = _fingerRelease = false;
+			debug(1, "Grim Mouse: finger lifted: key %d up", _fingerKey);
+		}
+	}
+	if (_momKind == kMNone)
+		return;
+	if (momentKind() != _momKind)
+		return momentStop("the game took the controls back");
+	if (g_grim->getMode() != GrimEngine::NormalMode)
+		return momentStop("not in play");
+	if (_momKind == kMComputer || _momKind == kMPrinter || _momKind == kMElevator)
+		return queueUpdate();
+	if (_cutScene > 0)
+		return momentStop("cut scene");
+	if (_momKind == kMAxe)
+		return axeUpdate();
+	lineUpdate();
+}
