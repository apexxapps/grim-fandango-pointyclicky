+// PointyClicky Edition (15 Nov 2026): a save keeps every outline it was made
+// with, so a fix to the edition's outlines would never reach it. After a load
+// the outlines come from the data again. A hotspot the scripts moved
+// (UpdateHotspot) keeps its place when its shape is unchanged, and keeps its
+// link to the game's object.
+void HotspotMan::refreshOutlines() {
+	HotDict fresh;
+	int numSets = 0;
+	if (!readSetBin(fresh, numSets))
+		return;
+	for (HotDict::iterator it = fresh.begin(); it != fresh.end(); ++it) {
+		Common::Array<MouseHotspot> &list = it->_value;
+		const Common::Array<MouseHotspot> *saved = _hotspots.find(it->_key) != _hotspots.end() ? &_hotspots[it->_key] : nullptr;
+		for (uint i = 0; i < list.size(); i++) {
+			MouseHotspot &hs = list[i];
+			// the k-th hotspot with this id on this setup, in the data and in the save
+			int k = 0;
+			for (uint j = 0; j < i; j++)
+				k += (list[j]._id == hs._id && list[j]._setup == hs._setup) ? 1 : 0;
+			const MouseHotspot *old = nullptr;
+			for (uint j = 0; saved && j < saved->size(); j++) {
+				const MouseHotspot &o = (*saved)[j];
+				if (o._id == hs._id && o._setup == hs._setup && k-- == 0) {
+					old = &o;
+					break;
+				}
+			}
+			if (old && old->_objId >= 0 && old->_objId < (int)_hotobject.size() && _hotobject[old->_objId]._id == hs._id)
+				hs._objId = old->_objId;
+			else
+				for (uint n = 0; n < _hotobject.size(); n++)
+					if (_hotobject[n]._id == hs._id)
+						hs._objId = n;
+			if (old && old->_region._pnts.size() == hs._region._pnts.size() && !hs._region._pnts.empty()) {
+				Common::Point d = old->_region._pnts[0] - hs._region._pnts[0];
+				bool moved = d.x != 0 || d.y != 0;
+				for (uint j = 1; moved && j < hs._region._pnts.size(); j++)
+					moved = old->_region._pnts[j] - hs._region._pnts[j] == d;
+				if (moved)
+					for (uint j = 0; j < hs._region._pnts.size(); j++)
+						hs._region._pnts[j] += d;
+			}
+		}
+	}
+	_hotspots = fresh;
+}
